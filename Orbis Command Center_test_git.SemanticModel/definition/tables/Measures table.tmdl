			            _totalval_ca_default,
			            _totalval_ca_nd
			        )
			    VAR res_ca =
			        DIVIDE ( _pgval_ca, _totalval_ca, BLANK () ) ----------------------------------------------------------------------------------------
			    ------------------------------------------FrontShop-------------------------------------
			    VAR _pgval_fs =
			        CALCULATE (
			            [Value PXM],
