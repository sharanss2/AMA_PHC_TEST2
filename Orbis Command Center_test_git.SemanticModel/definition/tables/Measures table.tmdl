	measure 'Measure 2'
		lineageTag: 86b88a51-a3b9-438f-920b-06162c422e04

		annotation 436ba87b-9c83-4389-a31b-ebd06a36be98 = {"Expression":null}

		annotation 277cc1b9-af89-4597-8e15-cacc25c0886b = To use special characters in a measure name, enclose the entire name in brackets ( [] ) and add a ] to any closing brackets in the name.

	measure 'DEBUG SKU Share Numerator' =
			
			VAR _pgval_ca_default =
			    CALCULATE (
			        [Value PXM],
			        ALL ( orbis_dimension_01[customer] ),
			        orbis_dimension_01[customer] = "TOTAL TD/ST"
			    )
			VAR _pgval_ca_nd =
			    CALCULATE (
			        [Value PXM],
			        ALL ( orbis_dimension_01[DataType] )
			    )
			VAR _pgval_ca =
			    IF (
			        NOT ISFILTERED ( orbis_dimension_01[customer] ),
			        _pgval_ca_default,
			        _pgval_ca_nd
			    )
			
			VAR _pgval_fs =
			    CALCULATE (
			        [Value PXM],
			        ALL ( orbis_dimension_01[DataType] ),
			        orbis_dimension_01[DataType] IN { "IQVIA_FRONTSHOP" }
			    )
			
			VAR _pgval_bs =
			    CALCULATE (
			        [Value PXM],
			        ALL ( orbis_dimension_01[DataType] ),
			        orbis_dimension_01[DataType] IN { "IQVIA_BACKSHOP" }
			    )
			
			VAR _pgval =
			    SWITCH (
			        TRUE (),
			        SELECTEDVALUE ( orbis_dimension_01[DataType] ) IN { "IQVIA_CONSUMERAISLE" }, _pgval_ca,
			        SELECTEDVALUE ( orbis_dimension_01[DataType] ) IN { "IQVIA_FRONTSHOP" }, _pgval_fs,
			        SELECTEDVALUE ( orbis_dimension_01[DataType] ) IN { "IQVIA_BACKSHOP" }, _pgval_bs,
			        _pgval_ca + _pgval_fs + _pgval_bs
			    )
			RETURN
			    _pgval
		lineageTag: 2bb13d2e-c7be-48b7-8def-e0f2286e598a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'DEBUG SKU Share Denominator' =
			
			VAR _totalval_ca_default =
			    CALCULATE (
			        [Value PXM],
			        ALL ( orbis_dimension_01[PG Category] ),
			        ALL ( orbis_dimension_01[Brand] ),
			        ALL ( orbis_dimension_01[P&G Flag] ),
			        ALL ( orbis_dimension_01[customer] ),
			        ALL ( orbis_dimension_01[Product] ),
			        orbis_dimension_01[customer] = "TOTAL TD/ST"
			    )
			VAR _totalval_ca_nd =
			    CALCULATE (
			        [Value PXM],
			        ALL ( orbis_dimension_01[Brand] ),
			        ALL ( orbis_dimension_01[P&G Flag] ),
			        ALL ( orbis_dimension_01[DataType] ),
			        ALL ( orbis_dimension_01[PG Category] ),
			        ALL ( orbis_dimension_01[Product] ),
			        orbis_dimension_01[DataType] IN { "CONSUMER AISLE" }
			    )
			VAR _totalval_ca =
			    IF (
			        NOT ISFILTERED ( orbis_dimension_01[customer] ),
			        _totalval_ca_default,
			        _totalval_ca_nd
			    )
			
			VAR _totalval_fs =
			    CALCULATE (
			        [Value PXM],
			        ALL ( orbis_dimension_01[Brand] ),
			        ALL ( orbis_dimension_01[P&G Flag] ),
			        ALL ( orbis_dimension_01[DataType] ),
			        ALL ( orbis_dimension_01[PG Category] ),
			        ALL ( orbis_dimension_01[Product] ),
			        orbis_dimension_01[DataType] IN { "IQVIA_FRONTSHOP" }
			    )
			
			VAR _totalval_bs =
			    CALCULATE (
			        [Value PXM],
			        ALL ( orbis_dimension_01[Brand] ),
			        ALL ( orbis_dimension_01[P&G Flag] ),
			        ALL ( orbis_dimension_01[DataType] ),
			        ALL ( orbis_dimension_01[PG Category] ),
			        ALL ( orbis_dimension_01[Product] ),
			        orbis_dimension_01[DataType] IN { "IQVIA_BACKSHOP" }
			    )
			
			VAR _totalval =
			    _totalval_ca + _totalval_fs + _totalval_bs
			RETURN
			    _totalval
		lineageTag: 5173d1c1-eb80-4bdf-9be1-5231755d1d2a

