	measure 'P&G Category Value Share' = ```
			
			VAR _pgval_ca_default =
			    CALCULATE (
			        [Value PXM],
			        --ALL(orbis_dimension_01[P&G Flag]), orbis_dimension_01[P&G Flag] = 1, 
			        ALL ( orbis_dimension_01[customer] ),
			        orbis_dimension_01[customer] = "TOTAL TD/ST"
			    )
			VAR _totalval_ca_default =
			    CALCULATE (
			        [Value PXM],
			        ALL ( orbis_dimension_01[Brand] ),
			        ALL ( orbis_dimension_01[P&G Flag] ),
			        ALL ( orbis_dimension_01[customer] ),
			        ALL (orbis_dimension_01[PG Category] ),
			        orbis_dimension_01[customer] = "TOTAL TD/ST"
			    )
			VAR _pgval_ca_nd =
			    CALCULATE (
			        [Value PXM],
			        --ALL(orbis_dimension_01[P&G Flag]), orbis_dimension_01[P&G Flag] = 1, 
			        ALL ( orbis_dimension_01[DataType] )
			    )
			VAR _totalval_ca_nd =
			    CALCULATE (
			        [Value PXM],
			        ALL ( orbis_dimension_01[Brand] ),
			        ALL ( orbis_dimension_01[P&G Flag] ),
			        ALL ( orbis_dimension_01[DataType] ),
			        ALL (orbis_dimension_01[PG Category] )
			    ) ------------------------------------------  Consumer Aisle --------------------------------------
			VAR _pgval_ca =
			    IF (
			        NOT ISFILTERED ( orbis_dimension_01[customer] ),
			        _pgval_ca_default,
			        _pgval_ca_nd
			    )
			VAR _totalval_ca =
			    IF (
			        NOT ISFILTERED ( orbis_dimension_01[customer] ),
			        _totalval_ca_default,
			        _totalval_ca_nd
			    )
			VAR res_ca =
			    DIVIDE ( _pgval_ca, _totalval_ca, BLANK () ) -------------------------------------------------------------------------------------------------
			------------------------------------------FrontShop-------------------------------------
			VAR _pgval_fs =
			    CALCULATE (
			        [Value PXM],
			        --ALL(orbis_dimension_01[P&G Flag]), orbis_dimension_01[P&G Flag] = 1, 
			        ALL ( orbis_dimension_01[DataType] ),
			        orbis_dimension_01[DataType] IN { "IQVIA_FRONTSHOP" }
			    )
			VAR _totalval_fs =
			    CALCULATE (
			        [Value PXM],
			        ALL ( orbis_dimension_01[Brand] ),
			        ALL ( orbis_dimension_01[P&G Flag] ),
			        ALL ( orbis_dimension_01[DataType] ),
			        ALL (orbis_dimension_01[PG Category] ),
			        orbis_dimension_01[DataType] IN { "IQVIA_FRONTSHOP" }
			    )
			VAR res_fb =
			    DIVIDE ( _pgval_fs, _totalval_fs, BLANK () ) -------------------------------------------------------------------------------------------------
			------------------------------------------Backshop-------------------------------------
			VAR _pgval_bs =
			    CALCULATE (
			        [Value PXM],
			        --ALL(orbis_dimension_01[P&G Flag]), orbis_dimension_01[P&G Flag] = 1, 
			        ALL ( orbis_dimension_01[DataType] ),
			        orbis_dimension_01[DataType] IN { "IQVIA_BACKSHOP" }
			    )
			VAR _totalval_bs =
			    CALCULATE (
			        [Value PXM],
			        ALL ( orbis_dimension_01[Brand] ),
			        ALL ( orbis_dimension_01[P&G Flag] ),
			        ALL ( orbis_dimension_01[DataType] ),
			        ALL (orbis_dimension_01[PG Category] ),
			        orbis_dimension_01[DataType] IN { "IQVIA_BACKSHOP" }
			    ) // VAR res_fb = DIVIDE(_pgval_bs, _totalval_bs, BLANK())
			-------------------------------------------------------------------------------------------------
			----------------------------------------Total----------------------------------------------------
			VAR _pgval =
			    SWITCH (
			        TRUE (),
			        SELECTEDVALUE ( orbis_dimension_01[DataType] ) IN { "IQVIA_CONSUMERAISLE" }, _pgval_ca,
			        SELECTEDVALUE ( orbis_dimension_01[DataType] ) IN { "IQVIA_FRONTSHOP" }, _pgval_fs,
			        SELECTEDVALUE ( orbis_dimension_01[DataType] ) IN { "IQVIA_BACKSHOP" }, _pgval_bs,
			        _pgval_ca + _pgval_fs + _pgval_bs
			    )
			VAR _totalval =
			    SWITCH (
			        TRUE (),
			        SELECTEDVALUE ( orbis_dimension_01[DataType] ) IN { "IQVIA_CONSUMERAISLE" }, _totalval_ca,
			        SELECTEDVALUE ( orbis_dimension_01[DataType] ) IN { "IQVIA_FRONTSHOP" }, _totalval_fs,
			        SELECTEDVALUE ( orbis_dimension_01[DataType] ) IN { "IQVIA_BACKSHOP" }, _totalval_bs,
			        _totalval_ca + _totalval_fs + _totalval_bs
			    )
			VAR res =
			    DIVIDE ( _pgval, _totalval, BLANK () )
			RETURN
			    res
			    // _pgval
			    // _totalval
			
			
			```
		lineageTag: a20ccd8d-886f-45fd-be02-4a1bdec908c9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Brand Value Share' =
			
			
			VAR _CurrentCategory =
			    SELECTEDVALUE(orbis_dimension_01[Category])
			
			/* ---------------- Category Total Base Filter ---------------- */
			
			VAR _CatAllBrands =
			    FILTER(
			        ALL(
			            orbis_dimension_01[Category],
			            orbis_dimension_01[PG Category],
			            orbis_dimension_01[Brand]
			        ),
			        orbis_dimension_01[Category] = _CurrentCategory
			            && NOT ISBLANK(orbis_dimension_01[Brand])
			    )
			
			/* -------------------------------- Consumer Aisle -------------------------------- */
			
			VAR _pgval_ca_default =
			    CALCULATE(
			        [Value PXM],
			        ALL(orbis_dimension_01[customer]),
			        orbis_dimension_01[customer] = "TOTAL TD/ST"
			    )
			
			VAR _totalval_ca_default =
			    CALCULATE(
			        [Value PXM],
			        _CatAllBrands,
			        ALL(orbis_dimension_01[P&G Flag]),
			        ALL(orbis_dimension_01[customer]),
			        orbis_dimension_01[customer] = "TOTAL TD/ST"
			    )
			
			VAR _pgval_ca_nd =
			    CALCULATE(
			        [Value PXM],
			        ALL(orbis_dimension_01[DataType])
			    )
			
			VAR _totalval_ca_nd =
			    CALCULATE(
			        [Value PXM],
			        _CatAllBrands,
			        ALL(orbis_dimension_01[P&G Flag]),
			        ALL(orbis_dimension_01[DataType])
			    )
			
			VAR _pgval_ca =
			    IF(
			        NOT ISFILTERED(orbis_dimension_01[customer]),
			        _pgval_ca_default,
			        _pgval_ca_nd
			    )
			
			VAR _totalval_ca =
			    IF(
			        NOT ISFILTERED(orbis_dimension_01[customer]),
			        _totalval_ca_default,
			        _totalval_ca_nd
			    )
			
			/* -------------------------------- Frontshop -------------------------------- */
			
			VAR _pgval_fs =
			    CALCULATE(
			        [Value PXM],
			        ALL(orbis_dimension_01[DataType]),
			        orbis_dimension_01[DataType] = "IQVIA_FRONTSHOP"
			    )
			
			VAR _totalval_fs =
			    CALCULATE(
			        [Value PXM],
			        _CatAllBrands,
			        ALL(orbis_dimension_01[P&G Flag]),
			        ALL(orbis_dimension_01[DataType]),
			        orbis_dimension_01[DataType] = "IQVIA_FRONTSHOP"
			    )
			
			/* -------------------------------- Backshop -------------------------------- */
			
			VAR _pgval_bs =
			    CALCULATE(
			        [Value PXM],
			        ALL(orbis_dimension_01[DataType]),
			        orbis_dimension_01[DataType] = "IQVIA_BACKSHOP"
			    )
			
			VAR _totalval_bs =
			    CALCULATE(
			        [Value PXM],
			        _CatAllBrands,
			        ALL(orbis_dimension_01[P&G Flag]),
			        ALL(orbis_dimension_01[DataType]),
			        orbis_dimension_01[DataType] = "IQVIA_BACKSHOP"
			    )
			
			VAR _totalval_all =
			    CALCULATE(
			        [Value PXM],
			        ALLEXCEPT(orbis_dimension_01, orbis_dimension_01[category])
			        // _CatAllBrands,
			        // ALL(orbis_dimension_01[PG Category]),
			        // ALL(orbis_dimension_01[Brand]),
			        // ALL(orbis_dimension_01[P&G Flag]),
			        // ALL(orbis_dimension_01[DataType]),
			        // ALL(orbis_dimension_01[DataType New])
			    )
			
			/* -------------------------------- Final Numerator -------------------------------- */
			
			VAR _pgval =
			    SWITCH(
			        TRUE(),
			        SELECTEDVALUE(orbis_dimension_01[DataType]) = "IQVIA_CONSUMERAISLE", _pgval_ca,
			        SELECTEDVALUE(orbis_dimension_01[DataType]) = "IQVIA_FRONTSHOP", _pgval_fs,
			        SELECTEDVALUE(orbis_dimension_01[DataType]) = "IQVIA_BACKSHOP", _pgval_bs,
			        _pgval_ca + _pgval_fs + _pgval_bs
			    )
			
			/* -------------------------------- Final Denominator -------------------------------- */
			
			VAR _totalval = _totalval_ca + _totalval_fs + _totalval_bs
			    // SWITCH(
			    //     TRUE(),
			    //     SELECTEDVALUE(orbis_dimension_01[DataType]) = "IQVIA_CONSUMERAISLE", _totalval_ca,
			    //     SELECTEDVALUE(orbis_dimension_01[DataType]) = "IQVIA_FRONTSHOP", _totalval_fs,
			    //     SELECTEDVALUE(orbis_dimension_01[DataType]) = "IQVIA_BACKSHOP", _totalval_bs,
			    //     // _totalval_ca + _totalval_fs + _totalval_bs
			    //    ISBLANK(SELECTEDVALUE(orbis_dimension_01[DataType])), _totalval_all
			    // )
			
			RETURN
			// _pgval
			// _totalval_all
			// _totalval_ca + _totalval_fs + _totalval_bs
			DIVIDE(_pgval, _totalval, BLANK())
		lineageTag: 467977ec-435d-4759-bbfb-9be3cade236c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Value Share new' = ```
			
			SWITCH(TRUE(),
			
			                    ISINSCOPE(orbis_dimension_01[Category]) && NOT ISINSCOPE(orbis_dimension_01[PG Category]) &&
			                     NOT ISINSCOPE(orbis_dimension_01[Brand])  && NOT ISINSCOPE(orbis_dimension_01[Segment])  && NOT ISINSCOPE(orbis_dimension_01[Product]), 
			                        1,
			                    ISINSCOPE(orbis_dimension_01[PG Category])
			                    && NOT ISINSCOPE(orbis_dimension_01[Brand])  && NOT ISINSCOPE(orbis_dimension_01[Segment])  && NOT ISINSCOPE(orbis_dimension_01[Product]), 
			                        [P&G Category Value Share],
			                    
			                    ISINSCOPE(orbis_dimension_01[Brand])
			                    && NOT ISINSCOPE(orbis_dimension_01[Segment])  && NOT ISINSCOPE(orbis_dimension_01[Product]), 
			                        [Brand Value Share],
			 
			                    ISINSCOPE(orbis_dimension_01[Segment]) && NOT ISINSCOPE(orbis_dimension_01[Product]),
			                        [Segment Value Share],
			
			                    ISINSCOPE(orbis_dimension_01[Product]), 
			                        [SKU Value Share],
			
			                    ISINSCOPE(orbis_dimension_01[Segment]) && NOT ISINSCOPE(orbis_dimension_01[Brand]) && NOT ISINSCOPE(orbis_dimension_01[Product]), 
			                        [Segment Value Share],
			
			                    // [Value Share Card]
			                    1
			                            )
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 655d9622-a8c9-4425-8291-87be8bbfd473

