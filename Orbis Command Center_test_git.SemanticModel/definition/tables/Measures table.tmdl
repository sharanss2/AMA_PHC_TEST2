	measure 'Show Shipment Customer for Selected Months' =
			
			VAR CustomerSet =
			    VALUES ( orbis_dimension_01[customer] )
			
			VAR ShipmentsInSelectedMonths =
			    SUMX (
			        VALUES ( 'Slicer Month Year'[Month Year] ),
			        VAR ThisMonth = 'Slicer Month Year'[Month Year]
			        RETURN
			            CALCULATE (
			                [Shipments],
			                REMOVEFILTERS ( 'Time Period' ),
			                FILTER (
			                    ALL ( DateTable[Month Year] ),
			                    DateTable[Month Year] = ThisMonth
			                ),
			                TREATAS ( CustomerSet, shipmenets_data_07[Customer] )
			            )
			    )
			
			RETURN
			IF ( COALESCE ( ShipmentsInSelectedMonths, 0 ) > 0, 1, BLANK() )
		formatString: 0
		lineageTag: 5eb182ba-4907-43d0-95f1-d26c5791886d

	measure '_Latest Available Date for all tables' = ```
			
			    VAR _maxdt_shipments = CALCULATE(MAX(shipmenets_data_07[GI_Date]), ALL(DateTable))
			    VAR _maxdt_iqvia = CALCULATE(MAX(iqvia_all_04[period_end_date]), ALL(DateTable))
			    VAR _maxdt_pos = CALCULATE(MAX(pos_data_03[Latest_date]), ALL(DateTable))
			
			    RETURN
			        "Shipment Latest Data: " & FORMAT(_maxdt_shipments, "yyyy-MM-dd") & UNICHAR(10) &
			        "POS Latest Data: " & FORMAT(_maxdt_pos, "yyyy-MM-dd") & UNICHAR(10) &
			        "IQVIA Latest Data: " & FORMAT(_maxdt_iqvia, "yyyy-MM-dd")
			```
