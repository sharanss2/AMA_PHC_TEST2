	measure 'Shipments MSU PXM Page' =
			
			VAR _SelectedPeriod =
			    SELECTEDVALUE ( 'Time Period'[Period] )
			
			VAR _SlicerDate =
			    MAX ( 'Slicer Month Year'[Date] )
			
			VAR _CalendarDate =
			    MAX ( DateTable[Date] )
			
			VAR _CurrentMonthStart =
			    DATE ( YEAR ( TODAY() ), MONTH ( TODAY() ), 1 )
			
			VAR _SelectedMonthStart =
			    DATE ( YEAR ( _SlicerDate ), MONTH ( _SlicerDate ), 1 )
			
			VAR _MaxDate =
			    IF (
			        ISFILTERED ( 'Slicer Month Year' ),
			        IF (
			            _SelectedMonthStart = _CurrentMonthStart,
			            EOMONTH ( _SlicerDate, -1 ),
			            EOMONTH ( _SlicerDate, 0 )
			        ),
			        EOMONTH ( _CalendarDate, 0 )
			    )
			
			RETURN
			SWITCH (
			    TRUE (),
			
			    _SelectedPeriod = "Current Month",
			        IF (
			            SELECTEDVALUE ( 'Slicer Month Year'[Current Month Year] ) = "Current Month",
			            CALCULATE ( [Shipments MSU Base], DATESMTD ( DateTable[Date] ) ),
			            BLANK()
			        ),
			
			    _SelectedPeriod = "P1M",
			        CALCULATE (
			            [Shipments MSU Base],
			            DATESINPERIOD ( DateTable[Date], _MaxDate, -1, MONTH )
			        ),
			
			    _SelectedPeriod = "P3M",
			        CALCULATE (
			            [Shipments MSU Base],
			            DATESINPERIOD ( DateTable[Date], _MaxDate, -3, MONTH )
			        ),
			
			    _SelectedPeriod = "P6M",
			        CALCULATE (
			            [Shipments MSU Base],
			            DATESINPERIOD ( DateTable[Date], _MaxDate, -6, MONTH )
			        ),
			
			    _SelectedPeriod = "P12M",
			        CALCULATE (
			            [Shipments MSU Base],
			            DATESINPERIOD ( DateTable[Date], _MaxDate, -12, MONTH )
			        ),
			
			    _SelectedPeriod = "MTD",
			        CALCULATE ( [Shipments MSU Base], DATESMTD ( DateTable[Date] ) ),
			
			    _SelectedPeriod = "QTD",
			        CALCULATE ( [Shipments MSU Base], DATESQTD ( DateTable[Date] ) ),
			
			    _SelectedPeriod = "FYTD",
			        CALCULATE (
			            [Shipments MSU Base],
			            CALCULATETABLE (
			                DATESYTD ( DateTable[Date], "06/30" ),
			                DateTable[Date] = _MaxDate
			            )
			        ),
			
			    [Shipments MSU Base]
			)
		lineageTag: 14d4853e-1cc3-4249-9559-9059f63382b7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

