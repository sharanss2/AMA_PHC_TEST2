	measure Projection = ```
			
			VAR salesp2m = CALCULATE(
			    [Sales (MSU)] ,
			    DATESINPERIOD(
			        DateTable[Date],
			        MAX(DateTable[Date]),
			        -3,
			        MONTH
			    )
			)  
			
			VAR denum = DIVIDE(salesp2m, 12)
			VAR num = CALCULATE([Closing Inventory Volume], ALL(DateTable), DateTable[RptMonthYear] = max(pos_data_03[YearMonthno]))
			VAR res = DIVIDE(num, denum, BLANK())
			RETURN
			IF(ISBLANK(res), "--", res)
			
