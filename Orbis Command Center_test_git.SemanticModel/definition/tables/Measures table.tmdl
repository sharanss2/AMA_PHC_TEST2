	measure '_Dynamic title Sales Out Summary' =
			
			VAR val = "Sales Out GIV (in MM)"
			VAR volMSU = "Sales Out Volume (in MSU)"
			VAR volUnits = "Sales Out Volume (in Units)"
			RETURN
			SWITCH (
			    SELECTEDVALUE ( 'Switcher Table'[Value/Volume], "Value" ),
			    "Value", val,
			    "Volume (MSU)", volMSU,
			    "Volume (Units)", volUnits,
			    val
			)
		lineageTag: 5b1833f6-f7a2-47ae-b509-b9deefb6833f

