		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Show IQVIA All Month Range' =
			
			
			VAR SelectedDate = MIN('Slicer Month Year'[Date]) -- The first day of the month selected in slicer
			VAR EndDate = EOMONTH(TODAY(), 0)         -- The last day of the current month
			VAR MatrixDate = MAX(iqvia_all_04[period_end_date])         -- The date currently being drawn in the Matrix
			
			RETURN
			IF(
			    MatrixDate >= SelectedDate && MatrixDate <= EndDate,
			    1,
			   BLANK()
			)
		formatString: 0
		lineageTag: ad7dcc7b-cbfd-4f2a-b814-a4cfca717e96

	measure 'Filtered IQVIA IYA' = ```
			
			VAR VisibleSales =     SUMX(
			        VALUES('DateTable'[Month Year]),
			        IF([Show IQVIA All Month Range] = 1, [IQVIA Sales PXM], BLANK())
			    )
			VAR VisibleLYSales = 
			    SUMX(
			        VALUES('DateTable'[Month Year]),
			        IF([Show IQVIA All Month Range] = 1, [IQVIA Sales LY PXM], BLANK())
			    )
			RETURN
			DIVIDE(VisibleSales, VisibleLYSales) * 100
			// IF(
			//     [Show POS Month Range] = 1, 
			//     [Shipments IYA PXM], 
			//     BLANK()
			// )
