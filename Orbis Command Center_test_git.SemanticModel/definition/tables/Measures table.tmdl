	measure 'Sales Value/Volume IYA PXM 2' = ```
			
			VAR _consumption = VALUES(orbis_dimension_01[Consumption Indicator])
			VAR _pos = [POS Sales PXM]
			VAR _posly = [POS Sales LY PXM]
			VAR _shipments = [Shipments PXM]
			VAR _shipmentsly = [Shipments LY PXM]
			VAR _cy =     SWITCH(
			        TRUE(),
			        ISBLANK(_consumption), _pos + _shipments,
			        _consumption = "Consumption", _pos,
			        _consumption = "Non-Consumption", _shipments,
			        BLANK()
			    )
			
			VAR _ly =     SWITCH(
			        TRUE(),
			        ISBLANK(_consumption), _posly + _shipmentsly,
			        _consumption = "Consumption", _posly,
			        _consumption = "Non-Consumption", _shipmentsly,
			        BLANK()
			    )
			
			
			
			VAR VisibleSales =     SUMX(
			        VALUES('DateTable'[Month Year]),
			        IF([Show POS Month Range] = 1, _cy)
			    )
			VAR VisibleLYSales = 
			    SUMX(
			        VALUES('DateTable'[Month Year]),
			        IF([Show POS Month Range] = 1, _ly)
			    )
			VAR res = DIVIDE(VisibleSales, VisibleLYSales) * 100
			RETURN
			res
			```
		lineageTag: 0c6dff43-c738-4664-b4df-58811e01ec25

