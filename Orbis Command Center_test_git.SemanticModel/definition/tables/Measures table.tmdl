	measure 'Brand Rank Per Category' =
			
			VAR CurrentCategory = SELECTEDVALUE(orbis_dimension_01[category])
			RETURN
			RANKX(
			    FILTER(
			        ALL(orbis_dimension_01[Brand]),
			        CALCULATE(
			            [Value P12M],
			            orbis_dimension_01[category] = CurrentCategory
			        ) > 0
			    ),
			    CALCULATE([Value P12M]),
			    ,
			    DESC,
			    DENSE
			)
		formatString: 0
		lineageTag: 9f265871-f21b-4b06-8280-6637f298e394

