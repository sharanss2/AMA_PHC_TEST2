	measure 'SKU Value Share' = ```
			
			VAR _pgval_ca_default =
			    CALCULATE (
			        [Value PXM],
			        ALL ( orbis_dimension_01[customer] ),
			        orbis_dimension_01[customer] = "TOTAL TD/ST"
			    )
			    VAR _totalval_ca_default = 
			        //     CALCULATE (
			        //     [Value PXM],
			        //     ALLEXCEPT(orbis_dimension_01, orbis_dimension_01[Segment]),
			        //     orbis_dimension_01[customer] = "TOTAL TD/ST"
			        // )
			        CALCULATE (
			            [Value PXM],
			            ALL ( orbis_dimension_01[PG Category] ),
			            ALL ( orbis_dimension_01[Brand] ),
			            ALL ( orbis_dimension_01[P&G Flag] ),
			            ALL ( orbis_dimension_01[customer] ),
			            ALL (orbis_dimension_01[Product] ),
			            // ALL ( orbis_dimension_01[DataType] ),
			            // ALL ( orbis_dimension_01[DataType New] ),
			            orbis_dimension_01[customer] = "TOTAL TD/ST"
			            // orbis_dimension_01[DataType] IN { "IQVIA_CONSUMERAISLE" }
			        )
			VAR _pgval_ca_nd =
			    CALCULATE ( [Value PXM]
			    , ALL ( orbis_dimension_01[DataType] ) 
			    )
			VAR _totalval_ca_nd =
			        CALCULATE (
			            [Value PXM],
			            ALL ( orbis_dimension_01[Brand] ),
			            ALL ( orbis_dimension_01[P&G Flag] ),
			            ALL ( orbis_dimension_01[DataType] ),
			            ALL ( orbis_dimension_01[PG Category] ),
			            ALL (orbis_dimension_01[Product] ),
			            orbis_dimension_01[DataType] IN { "CONSUMER AISLE" }
			        ) ------------------------------------------  Consumer Aisle --------------------------------------
			VAR _pgval_ca =
			    IF (
			        NOT ISFILTERED ( orbis_dimension_01[customer] ),
			        _pgval_ca_default,
			        _pgval_ca_nd
			    )
			VAR _totalval_ca =
			    IF (
			        NOT ISFILTERED ( orbis_dimension_01[customer] ),
			        _totalval_ca_default,
			        _totalval_ca_nd
			    )
			// VAR res_ca =
			//     DIVIDE ( _pgval_ca, _totalval_ca, BLANK () ) -------------------------------------------------------------------------------------------------
			------------------------------------------FrontShop-------------------------------------
			VAR _pgval_fs =
			    CALCULATE (
			        [Value PXM],
			        ALL ( orbis_dimension_01[DataType] ),
			        orbis_dimension_01[DataType] IN { "IQVIA_FRONTSHOP" }
			    )
			VAR _totalval_fs =
			        CALCULATE (
			            [Value PXM],
			            ALL ( orbis_dimension_01[Brand] ),
			            ALL ( orbis_dimension_01[P&G Flag] ),
			            ALL ( orbis_dimension_01[DataType] ),
			            ALL ( orbis_dimension_01[PG Category] ),
			            ALL (orbis_dimension_01[Product] ),
			            orbis_dimension_01[DataType] IN { "IQVIA_FRONTSHOP" }
			        )
			// VAR res_fb =
			//     DIVIDE ( _pgval_fs, _totalval_fs, BLANK () ) -------------------------------------------------------------------------------------------------
			------------------------------------------Backshop-------------------------------------
			VAR _pgval_bs =
			    CALCULATE (
			        [Value PXM],
			        ALL ( orbis_dimension_01[DataType] ),
			        orbis_dimension_01[DataType] IN { "IQVIA_BACKSHOP" }
			    )
			VAR _totalval_bs =
			        CALCULATE (
			            [Value PXM],
			            ALL ( orbis_dimension_01[Brand] ),
			            ALL ( orbis_dimension_01[P&G Flag] ),
			            ALL ( orbis_dimension_01[DataType] ),
			            ALL ( orbis_dimension_01[PG Category] ),
			            ALL (orbis_dimension_01[Product] ),
			            orbis_dimension_01[DataType] IN { "IQVIA_BACKSHOP" }
			    ) // VAR res_fb = DIVIDE(_pgval_bs, _totalval_bs, BLANK())
			-------------------------------------------------------------------------------------------------
			----------------------------------------Total----------------------------------------------------
			VAR _pgval =
			    SWITCH (
			        TRUE (),
			        SELECTEDVALUE ( orbis_dimension_01[DataType] ) IN { "IQVIA_CONSUMERAISLE" }, _pgval_ca,
			        SELECTEDVALUE ( orbis_dimension_01[DataType] ) IN { "IQVIA_FRONTSHOP" }, _pgval_fs,
			        SELECTEDVALUE ( orbis_dimension_01[DataType] ) IN { "IQVIA_BACKSHOP" }, _pgval_bs,
			        _pgval_ca + _pgval_fs + _pgval_bs
			    )
			
			// VAR _totalval =
			//         CALCULATE (
			//             [Value PXM],
			//             ALL ( orbis_dimension_01[Brand] ),
			//             ALL ( orbis_dimension_01[P&G Flag] ),
			//             ALL ( orbis_dimension_01[DataType] ),
			//             ALL ( orbis_dimension_01[PG Category] ),
			//             ALL (orbis_dimension_01[Product] ),
			//             orbis_dimension_01[DataType] IN { "IQVIA_BACKSHOP", "IQVIA_FRONTSHOP", "IQVIA_CONSUMERAISLE" })
			VAR _totalval = _totalval_ca + _totalval_fs + _totalval_bs
			    // SWITCH (
			    //     TRUE (),
			    //     ISBLANK(SELECTEDVALUE(orbis_dimension_01[DataType New])), _totalval_ca ,
			    //     SELECTEDVALUE ( orbis_dimension_01[DataType] ) IN { "IQVIA_CONSUMERAISLE" }, _totalval_ca,
			    //     SELECTEDVALUE ( orbis_dimension_01[DataType] ) IN { "IQVIA_FRONTSHOP" }, _totalval_fs,
			    //     SELECTEDVALUE ( orbis_dimension_01[DataType] ) IN { "IQVIA_BACKSHOP" }, _totalval_bs,
			    //     _totalval_ca + _totalval_fs + _totalval_bs
			    // )
			VAR res =
			    DIVIDE ( _pgval, _totalval, BLANK () )
			RETURN
			    // _pgval
			    res
			    // _totalval
			    // _totalval_ca
			
			```
