	measure 'Shipments PXM' = ```
			
			
			VAR LatestShipmentDateCurrentMonth =
			    CALCULATE (
			        MAX ( shipmenets_data_07[GI_Date] ),
			        FILTER (
			            ALL ( shipmenets_data_07[GI_Date] ),
			            YEAR ( shipmenets_data_07[GI_Date] ) = YEAR ( TODAY() )
			                && MONTH ( shipmenets_data_07[GI_Date] ) = MONTH ( TODAY() )
			        )
			    )
			    
			VAR _SelectedPeriod =
			SELECTEDVALUE ( 'Time Period'[Period] )
			
			VAR _SlicerDate =
			MAX ( 'Slicer Month Year'[Date] )
			
			VAR _CalendarDate =
			MAX ( DateTable[Date] )
			
			VAR _CurrentMonthStart =
			DATE ( YEAR ( TODAY() ), MONTH ( TODAY() ), 1 )
			
			VAR _SelectedMonthStart =
			DATE ( YEAR ( _SlicerDate ), MONTH ( _SlicerDate ), 1 )
			
			VAR _MaxDate =
			IF (
			ISFILTERED ( 'Slicer Month Year' ),
			IF (
			_SelectedMonthStart = _CurrentMonthStart,
			EOMONTH ( _SlicerDate, -1 ),
			EOMONTH ( _SlicerDate, 0 )
			),
			EOMONTH ( _CalendarDate, 0 )
			)
			
			RETURN
			SWITCH (
			TRUE (),
			
			// /* Current Month */
			// _SelectedPeriod = "Current Month",
			//     IF(SELECTEDVALUE('Slicer Month Year'[Current Month Year]) = "Current Month",
			//     CALCULATE (
			//         [Shipments],
			//         DATESMTD ( DateTable[Date] )
			//     ), BLANK()),
			
			    /* Current Month */
			    _SelectedPeriod = "Current Month",
			        IF (
			            SELECTEDVALUE ( 'Slicer Month Year'[Current Month Year] ) = "Current Month",
			            CALCULATE (
			                [Shipments],
			                DATESBETWEEN (
			                    DateTable[Date],
			                    DATE (
			                        YEAR ( LatestShipmentDateCurrentMonth ),
			                        MONTH ( LatestShipmentDateCurrentMonth ),
			                        1
			                    ),
			                    LatestShipmentDateCurrentMonth
			                )
			            ),
			            BLANK()
			        ),
			
			    /* P1M */
			    _SelectedPeriod = "P1M",
			        CALCULATE (
			            [Shipments],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -1,
			                MONTH
			            )
			        ),
			
			    /* P3M */
			    _SelectedPeriod = "P3M",
			        CALCULATE (
			            [Shipments],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -3,
			                MONTH
			            )
			        ),
			
			    /* P6M */
			    _SelectedPeriod = "P6M",
			        CALCULATE (
			            [Shipments],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -6,
			                MONTH
			            )
			        ),
			
			    /* P12M */
			    _SelectedPeriod = "P12M",
			        CALCULATE (
			            [Shipments],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -12,
			                MONTH
			            )
			        ),
			
			    /* MTD */
			    _SelectedPeriod = "MTD",
			        CALCULATE (
			            [Shipments],
			            DATESMTD ( DateTable[Date] )
			        ),
			
			    /* QTD */
			    _SelectedPeriod = "QTD",
			        CALCULATE (
			            [Shipments],
			            DATESQTD ( DateTable[Date] )
			        ),
			
			    /* FYTD (July-June) */
			    _SelectedPeriod = "FYTD",
			        CALCULATE (
			            [Shipments],
			            CALCULATETABLE (
