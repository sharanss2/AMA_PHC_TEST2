	measure 'Front Shop Sales' =
			
			VAR val = [Value New 2]
			VAR vol = [Volume New 2]
			VAR Units = [Volume New 3]
			
			VAR res = SWITCH(SELECTEDVALUE('Switcher Table'[Value/Volume]), "Value", val, "Volume (MSU)", vol, "Volume (Units)", Units)
			RETURN
			res
