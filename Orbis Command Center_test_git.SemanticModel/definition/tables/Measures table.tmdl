	measure 'Temp Denum' = ```
			
			VAR _val = 
			    SWITCH( TRUE(),
			        ISINSCOPE(product_dim_01[Product]), [Value PXM],
			        ISINSCOPE(brand_dim_01[Brand]), [Value PXM],
			        ISINSCOPE(segment_dim_01[Segment]), [Value PXM],
			        -- Category level: Respect the Category filter without stripping SKU selections
			        CALCULATE(
			            [Value PXM],
			            KEEPFILTERS(ALLSELECTED(category_dim_01[Category]))
			        )
			    )
			
			-- 2. Denominator Part A: Competitor Value (P&G Flag = 0)
			-- We clear Brand/SKU filters to get the total category/segment market
			VAR _compval = 
			    CALCULATE(
			        [Value PXM], 
			        REMOVEFILTERS(brand_dim_01[Brand]),REMOVEFILTERS( product_dim_01[Product]), REMOVEFILTERS(segment_dim_01[Segment]),
			        brand_dim_01[P&G Flag] = 0,
			        KEEPFILTERS('Time Period')
			    )
			
			-- 3. Denominator Part B: P&G Value (P&G Flag = 1)
			VAR _pgval = 
			    CALCULATE(
			        [Value PXM], 
			        REMOVEFILTERS(iqvia_data_01[Brand]), REMOVEFILTERS(iqvia_data_01[Product]), REMOVEFILTERS(segment_dim_01[Segment]), 
			        iqvia_data_01[P&G Flag] = 1,
			        KEEPFILTERS('Time Period')
			    )
			
			-- 4. Final Calculation
			VAR _TotalMarket = _pgval + _compval
			
			VAR res = IF(
			    NOT ISBLANK(_val) && _val <> 0,
			    DIVIDE(_val, _TotalMarket)
			)
			
			RETURN
			-- Only show result if there is a valid numerator (hides irrelevant Categories)
			// IF(NOT ISINSCOPE(brand_dim_01[Brand]) , 1, res)
			// res
			_TotalMarket
			```
		lineageTag: da1f181e-fee6-4358-aa34-57fc216c0359

