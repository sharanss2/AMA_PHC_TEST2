		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'POS Sales PXM' = ```
			
			VAR _SelectedPeriod =
			SELECTEDVALUE ( 'Time Period'[Period] )
			
			VAR _SlicerDate =
			MAX ( 'Slicer Month Year'[Date] )
			
			VAR _CalendarDate =
			MAX ( DateTable[Date] )
			
			VAR _CurrentMonthStart =
			DATE ( YEAR ( TODAY() ), MONTH ( TODAY() ), 1 )
			
			VAR _SelectedMonthStart =
			DATE ( YEAR ( _SlicerDate ), MONTH ( _SlicerDate ), 1 )
			
			VAR _MaxDate =
			IF (
			ISFILTERED ( 'Slicer Month Year' ),
			IF (
			_SelectedMonthStart = _CurrentMonthStart,
			EOMONTH ( _SlicerDate, -1 ),
			EOMONTH ( _SlicerDate, 0 )
			),
			EOMONTH ( _CalendarDate, 0 )
			)
			
			RETURN
			SWITCH (
			TRUE (),
			
			/* Current Month */
			_SelectedPeriod = "Current Month",
			    IF(SELECTEDVALUE('Slicer Month Year'[Current Month Year]) = "Current Month",
			    CALCULATE (
			        [POS Sales],
			        DATESMTD ( DateTable[Date] )
			    ), BLANK()),
			
			    /* P1M */
			    _SelectedPeriod = "P1M",
			        CALCULATE (
			            [POS Sales],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -1,
			                MONTH
			            )
			        ),
			
			    /* P3M */
			    _SelectedPeriod = "P3M",
			        CALCULATE (
			            [POS Sales],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -3,
			                MONTH
			            )
			        ),
			
			    /* P6M */
			    _SelectedPeriod = "P6M",
			        CALCULATE (
			            [POS Sales],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -6,
			                MONTH
			            )
			        ),
			
			    /* P12M */
			    _SelectedPeriod = "P12M",
			        CALCULATE (
			            [POS Sales],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -12,
			                MONTH
			            )
			        ),
			
			    /* MTD */
			    _SelectedPeriod = "MTD",
			        CALCULATE (
			            [POS Sales],
			            DATESMTD ( DateTable[Date] )
			        ),
			
			    /* QTD */
			    _SelectedPeriod = "QTD",
			        CALCULATE (
			            [POS Sales],
			            DATESQTD ( DateTable[Date] )
			        ),
			
			    /* FYTD (July-June) */
			    _SelectedPeriod = "FYTD",
			        CALCULATE (
			            [POS Sales],
			            CALCULATETABLE (
			                DATESYTD (
			                    DateTable[Date],
			                    "06/30"
			                ),
			                DateTable[Date] = _MaxDate
			            )
			        ),
			
			    /* Default */
			    [POS Sales]
			)
			
			// POS Sales PXM = 
			// VAR _SelectedPeriod =
			//     SELECTEDVALUE ( 'Time Period'[Period] )
			
			// // VAR _MaxDate =
			// //    MAX ( DateTable[Date] )
			// VAR _SlicerDate = MIN('Slicer Month Year'[Date])
			// VAR _CalendarDate = MIN(DateTable[Date])
			// VAR _MaxDate = 
			//     IF ( 
			//         ISFILTERED('Slicer Month Year'), 
			//         EOMONTH(_SlicerDate, 0), -- Use the end of the month from the slicer
			//         EOMONTH(_CalendarDate, 0)     -- Fallback to default behavior
			//     )
			
			// RETURN
			// // _MaxDate
			// SWITCH (    
			//     TRUE(),
			
			//     /* P1M */
			//     _SelectedPeriod = "P1M",
			//         CALCULATE (
			//             [POS Sales],
			//             DATESINPERIOD (
			//                 DateTable[Date],
			//                 _MaxDate,
			//                 -1,
			//                 MONTH
			//             )
			//         ),
			
			//     /* P3M */
			//     _SelectedPeriod = "P3M",
			//         CALCULATE (
			//            [POS Sales],
			//             DATESINPERIOD (
			//                 DateTable[Date],
			//                 _MaxDate,
			//                 -3,
			//                 MONTH
			//             )
			//         ),
			
			//     /* P6M */
			//     _SelectedPeriod = "P6M",
			//         CALCULATE (
			//             [POS Sales],
			//             DATESINPERIOD (
			//                 DateTable[Date],
