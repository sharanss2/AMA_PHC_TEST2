	measure 'Filtered POS_RTDX IYA' = ```
			
			
			VAR VisibleSales1 =     SUMX(
			        VALUES('DateTable'[Month Year]),
			        IF([Show POS Month Range] = 1, [POS Sales PXM])
			    )
			VAR VisibleLYSales1 = 
			    SUMX(
			        VALUES('DateTable'[Month Year]),
			        IF([Show POS Month Range] = 1, [POS Sales LY PXM])
			    )
			VAR res1 = DIVIDE(VisibleSales1, VisibleLYSales1) * 100
			
			VAR VisibleSales2 =     SUMX(
			        VALUES('DateTable'[Month Year]),
			        IF([Show RTDX Month Range] = 1, [RTDX Sales PXM])
			    )
			VAR VisibleLYSales2 = 
			    SUMX(
			        VALUES('DateTable'[Month Year]),
			        IF([Show RTDX Month Range] = 1, [RTDX Sales LY PXM])
			    )
			VAR res2 = DIVIDE(VisibleSales2, VisibleLYSales2) * 100
			
			RETURN
			SWITCH(SELECTEDVALUE(orbis_dimension_01[DataType]),
			"POS", res1, "RTDX", res2)
			// IF(
			//     [Show POS Month Range] = 1, 
			//     [POS Sales IYA PXM], 
