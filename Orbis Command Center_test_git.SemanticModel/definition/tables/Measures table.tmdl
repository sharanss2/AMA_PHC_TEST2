		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Shipments LY PXM' = ```
			
			VAR LatestShipmentDateCurrentMonth =
			    CALCULATE (
			        MAX ( shipmenets_data_07[GI_Date] ),
			        FILTER (
			            ALL ( shipmenets_data_07[GI_Date] ),
			            YEAR ( shipmenets_data_07[GI_Date] ) = YEAR ( TODAY() )
			                && MONTH ( shipmenets_data_07[GI_Date] ) = MONTH ( TODAY() )
			        )
			    )
			
			VAR _SelectedPeriod =
			    SELECTEDVALUE ( 'Time Period'[Period] )
			
			VAR _SlicerDate =
			    MAX ( 'Slicer Month Year'[Date] )
			
			VAR _CalendarDate =
			    MAX ( DateTable[Date] )
			
			VAR _CurrentMonthStart =
			    DATE ( YEAR ( TODAY() ), MONTH ( TODAY() ), 1 )
			
			VAR _SelectedMonthStart =
			    DATE ( YEAR ( _SlicerDate ), MONTH ( _SlicerDate ), 1 )
			
			VAR _MaxDate =
			    IF (
			        ISFILTERED ( 'Slicer Month Year' ),
			        IF (
			            _SelectedMonthStart = _CurrentMonthStart,
			            EOMONTH ( _SlicerDate, -1 ),
			            EOMONTH ( _SlicerDate, 0 )
			        ),
			        EOMONTH ( _CalendarDate, 0 )
			    )
			
			VAR _IsCurrentMonthSelected =
			    SELECTEDVALUE ( 'Slicer Month Year'[Current Month Year] ) = "Current Month"
			
			VAR _CurrentMonthLYStart =
			    IF (
			        ISBLANK ( LatestShipmentDateCurrentMonth ),
			        BLANK(),
			        DATE (
			            YEAR ( LatestShipmentDateCurrentMonth ) - 1,
			            MONTH ( LatestShipmentDateCurrentMonth ),
			            1
			        )
			    )
			
			VAR _CurrentMonthLYEnd =
			    IF (
			        ISBLANK ( LatestShipmentDateCurrentMonth ),
			        BLANK(),
			        DATE (
			            YEAR ( LatestShipmentDateCurrentMonth ) - 1,
			            MONTH ( LatestShipmentDateCurrentMonth ),
			            DAY ( LatestShipmentDateCurrentMonth )
			        )
			    )
			
			RETURN
			SWITCH (
			    TRUE (),
			
			    /* Current Month */
			    _SelectedPeriod = "Current Month",
			        IF (
			            _IsCurrentMonthSelected
			                && NOT ISBLANK ( LatestShipmentDateCurrentMonth ),
			            CALCULATE (
			                [Shipments],
			                DATESBETWEEN (
			                    DateTable[Date],
			                    _CurrentMonthLYStart,
			                    _CurrentMonthLYEnd
			                )
			            ),
			            BLANK()
			        ),
			
			    /* P1M */
			    _SelectedPeriod = "P1M",
			        CALCULATE (
			            [Shipments LY],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -1,
			                MONTH
			            )
			        ),
			
			    /* P3M */
			    _SelectedPeriod = "P3M",
			        CALCULATE (
			            [Shipments LY],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -3,
			                MONTH
			            )
			        ),
			
			    /* P6M */
			    _SelectedPeriod = "P6M",
			        CALCULATE (
			            [Shipments LY],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -6,
			                MONTH
			            )
			        ),
			
			    /* P12M */
			    _SelectedPeriod = "P12M",
			        CALCULATE (
			            [Shipments LY],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -12,
			                MONTH
			            )
			        ),
			
			    /* MTD */
			    _SelectedPeriod = "MTD",
			        CALCULATE (
			            [Shipments LY],
			            DATESMTD ( DateTable[Date] )
			        ),
			
			    /* QTD */
			    _SelectedPeriod = "QTD",
			        CALCULATE (
			            [Shipments LY],
			            DATESQTD ( DateTable[Date] )
			        ),
			
			    /* FYTD (July-June) */
			    _SelectedPeriod = "FYTD",
			        CALCULATE (
			            [Shipments LY],
			            CALCULATETABLE (
			                DATESYTD ( DateTable[Date], "06/30" ),
			                DateTable[Date] = _MaxDate
			            )
			        ),
			
			    /* Default */
			    [Shipments LY]
			)
			// VAR _SelectedPeriod =
			//     SELECTEDVALUE ( 'Time Period'[Period] )
			
			// // VAR _MaxDate =
			// //    MAX ( DateTable[Date] )
			
			// VAR _SlicerDate = MIN('Slicer Month Year'[Date])
			// VAR _CalendarDate = MIN(DateTable[Date])
			// VAR _MaxDate = 
			//     IF ( 
			//         ISFILTERED('Slicer Month Year'), 
			//         EOMONTH(_SlicerDate, 0), -- Use the end of the month from the slicer
			//         EOMONTH(_CalendarDate, 0)     -- Fallback to default behavior
			//     )
			
			// RETURN
			// // _MaxDate
			// SWITCH (    
			//     TRUE(),
			
			//     /* P1M */
			//     _SelectedPeriod = "P1M",
			//         CALCULATE (
			//             [Shipments LY],
			//             DATESINPERIOD (
			//                 DateTable[Date],
			//                 _MaxDate,
			//                 -1,
			//                 MONTH
			//             )
			//         ),
			
			//     /* P3M */
			//     _SelectedPeriod = "P3M",
			//         CALCULATE (
			//            [Shipments LY],
			//             DATESINPERIOD (
			//                 DateTable[Date],
			//                 _MaxDate,
			//                 -3,
			//                 MONTH
			//             )
			//         ),
			
			//     /* P6M */
			//     _SelectedPeriod = "P6M",
			//         CALCULATE (
			//             [Shipments LY],
			//             DATESINPERIOD (
			//                 DateTable[Date],
			//                 _MaxDate,
			//                 -6,
			//                 MONTH
			//             )
			//         ),
			
			//     /* P12M */
			//     _SelectedPeriod = "P12M",
			//         CALCULATE (
			//             [Shipments LY],
			//             DATESINPERIOD (
			//                 DateTable[Date],
			//                 _MaxDate,
			//                 -12,
			//                 MONTH
			//             )
