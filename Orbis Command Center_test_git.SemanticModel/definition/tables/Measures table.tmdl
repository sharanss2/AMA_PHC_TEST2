	measure 'NIT GIV' =
			
			VAR  StartCurrentMonth = DATE(YEAR(TODAY()),MONTH(TODAY()), 1)
			VAR  StartNextMonth = EDATE(StartCurrentMonth, 1)
			VAR  StartPrevMonth = EDATE(StartCurrentMonth, -1)
			// VAR res = CALCULATE(SUM(shipmenets_data_07[GIV]), shipmenets_data_07[Requested_Delivery_Date] >= StartCurrentMonth,shipmenets_data_07[Requested_Delivery_Date] < StartNextMonth , shipmenets_data_07[GI_Date] >= StartPrevMonth, shipmenets_data_07[GI_Date] < StartCurrentMonth)
			
			VAR res = CALCULATE(SUM(shipmenets_data_07[GIV]),
			// ALL(DateTable[Month Year], DateTable[Current Month Year]),
			 USERELATIONSHIP(DateTable[Date], shipmenets_data_07[Requested_Delivery_Date]),
			shipmenets_data_07[Requested_Delivery_Date] >= StartCurrentMonth,shipmenets_data_07[Requested_Delivery_Date] < StartNextMonth , shipmenets_data_07[GI_Date] >= StartPrevMonth, shipmenets_data_07[GI_Date] < StartCurrentMonth)
			
			RETURN
			// COALESCE(res,0)
			res
		lineageTag: 85c3361f-b1fe-4e77-8aa7-a67a249cd3a5

