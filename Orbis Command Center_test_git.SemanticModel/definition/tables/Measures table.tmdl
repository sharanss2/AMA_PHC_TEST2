	measure 'Volume LY' =
			
			
			VAR MaxDateWithData = CALCULATE(MAX(iqvia_all_04[period_end_date]), ALL(iqvia_all_04))
			RETURN
			SUMX(
			    KEEPFILTERS(VALUES(DateTable[Date])),
			    IF (
			        DateTable[Date] <= MaxDateWithData,
			        CALCULATE (
			            [Volume (Units)],
			            DATEADD ( DateTable[Date], -1, YEAR )
			        ),
			        BLANK()
			    )
			)
		lineageTag: 82f9d886-2552-467a-b6a2-ce6027a4c6f6

