		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Show iqvia all Month Range 2' =
			
			
			VAR SelectedDate = MIN(DateTable[Date]) -- The first day of the month selected in slicer
			VAR EndDate = EOMONTH(TODAY(), 0)         -- The last day of the current month
			VAR MatrixDate = MAX(iqvia_all_04[period_end_date])         -- The date currently being drawn in the Matrix
			
			RETURN
			IF(
			    MatrixDate >= SelectedDate && MatrixDate <= EndDate,
			    1,
			   BLANK()
			)
		formatString: 0
		lineageTag: 3c5e6f36-a922-4ca2-8bd3-54f2d5d9e491

	measure 'Front Shop Sales LY PXM 2' = ```
			
			VAR _SelectedPeriod =
			    SELECTEDVALUE ( 'Time Period'[Period] )
			
			// VAR _MaxDate =
			//    MAX ( DateTable[Date] )
			VAR _SlicerDate = MIN('Slicer Month Year'[Date])
			VAR _CalendarDate = MIN(DateTable[Date])
			
			VAR _Date = 
			        IF ( 
			        ISFILTERED('Slicer Month Year'), 
			        EOMONTH(_SlicerDate, 0), -- Use the end of the month from the slicer
			        EOMONTH(_CalendarDate, 0)     -- Fallback to default behavior
			    )
			
			VAR _MaxDate = 
			    IF ( 
			        ISFILTERED('Slicer Month Year'), 
			        EOMONTH(_SlicerDate, 0), -- Use the end of the month from the slicer
			        EOMONTH(_CalendarDate, 0)     -- Fallback to default behavior
			    )
			
			
			RETURN
			// _MaxDate
			SWITCH (    
			    TRUE(),
			
			    /* P1M */
			    _SelectedPeriod = "P1M",
			        CALCULATE (
			            [Front Shop Sales LY],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -1,
			                MONTH
			            )
			        ),
			
			    /* P3M */
			    _SelectedPeriod = "P3M",
			        CALCULATE (
			           [Front Shop Sales LY],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -3,
			                MONTH
			            )
			        ),
			
			    /* P6M */
			    _SelectedPeriod = "P6M",
			        CALCULATE (
			            [Front Shop Sales LY],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -6,
			                MONTH
			            )
			        ),
			
			    /* P12M */
			    _SelectedPeriod = "P12M",
			        CALCULATE (
			            [Front Shop Sales LY],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -12,
			                MONTH
			            )
			        ),
			
			    /* MTD */
			    _SelectedPeriod = "MTD",
			        CALCULATE (
			            [Front Shop Sales LY],
			            DATESMTD ( DateTable[Date] )
			        ),
			
			    /* QTD */
			    _SelectedPeriod = "QTD",
			        CALCULATE (
			            [Front Shop Sales LY],
			            DATESQTD ( DateTable[Date] )
			        ),
			
			    /* FYTD */
			    // _SelectedPeriod = "FYTD",
			    //     CALCULATE (
			    //         [Front Shop Sales LY],
			    //         DATESYTD (
			    //             DateTable[Date],
			    //             "06/30"   /* change if fiscal year end is different */
			    //         )
			    //     ),
			
			            /* FYTD (July to June) anchored to Slicer */
			    _SelectedPeriod = "FYTD",
			        CALCULATE (
			            [Front Shop Sales LY],
			            CALCULATETABLE (
			                DATESYTD ( DateTable[Date], "06/30" ),
			                DateTable[Date] = _Date
			            )
			        ),
			    /* Default fallback */
			    [Front Shop Sales LY]
			)
			```
		lineageTag: c561a129-f6b9-4472-b42b-9bad12c8567a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'IYA Visibility Filter POS & Shipments' = ```
			
			VAR SelectedDate = 
			    IF ( 
			        ISFILTERED('Slicer Month Year'), 
			        MIN('Slicer Month Year'[Date]), -- Use the end of the month from the slicer
			        MIN(DateTable[Date])     -- Fallback to default behavior
			    )
			// VAR SelectedDate = MIN(DateTable[Date]) -- Or your Period End Date
			VAR SelectedPeriod = SELECTEDVALUE('Time Period'[Period]) -- e.g., "FYTD", "P12M"
			
			RETURN
			SWITCH( TRUE(),
			    SelectedPeriod = "FYTD" && SelectedDate < DATE(2024, 8, 1), 0,
			    SelectedPeriod = "P12M" && SelectedDate < DATE(2025, 5, 1), 0,
			    SelectedPeriod = "P6M"  && SelectedDate < DATE(2024, 10, 1), 0,
			    SelectedPeriod = "P3M"  && SelectedDate < DATE(2024, 7, 1), 0,
			    SelectedPeriod = "P1M"  && SelectedDate < DATE(2024, 5, 1), 0,
			    1 -- Default to visible
			)
			
			// P12M IYA: dont show for selection before April 2025
			// P6M IYA: dont show for selection before October 2024
			// P3M IYA: dont show for selection before July 2024
			// P1M IYA: dont show for selection before May 2024
			// FYTD Sales: dont show for selection before July 2023
			// FYTD IYA: dont show for selection before July 2024
			 
			```
		formatString: 0
		lineageTag: 2994d2f9-df30-4a31-bc4b-b88ec6bcb2fa

	measure 'Sales Visibility Filter POS & Shipments' =
			
			VAR SelectedDate = MAX('Slicer Month Year'[Date]) -- Or your Period End Date
			VAR SelectedPeriod = SELECTEDVALUE('Time Period'[Period]) -- e.g., "FYTD", "P12M"
			RETURN
			SWITCH( TRUE(),
			    SelectedPeriod = "FYTD" && SelectedDate < DATE(2023, 8, 1), 0,
			    1 -- Default to visible
			)
		formatString: 0
		lineageTag: 7be30933-0a2d-4889-aeb3-8ec38399cc30

