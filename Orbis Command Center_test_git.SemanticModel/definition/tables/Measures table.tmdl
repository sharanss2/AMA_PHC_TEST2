	measure 'Segment Value Salience' = ```
			
			VAR _res_sharepage = 
			    VAR _pgval_ca_default =  CALCULATE([Value PXM], ALL(orbis_dimension_01[customer]), orbis_dimension_01[customer] = "TOTAL TD/ST")
			    VAR _totalval_ca_default = CALCULATE([Value PXM], ALL(orbis_dimension_01[Segment]),  ALL(orbis_dimension_01[P&G Flag]), ALL(orbis_dimension_01[customer]), orbis_dimension_01[customer] = "TOTAL TD/ST")
			
			    VAR _pgval_ca_nd =  CALCULATE([Value PXM], ALL(orbis_dimension_01[DataType]))
			    VAR _totalval_ca_nd = CALCULATE([Value PXM], ALL(orbis_dimension_01[Segment]), ALL(orbis_dimension_01[P&G Flag]), ALL(orbis_dimension_01[DataType]))
			    ------------------------------------------  Consumer Aisle --------------------------------------
			    VAR _pgval_ca = IF(NOT ISFILTERED(orbis_dimension_01[customer]), _pgval_ca_default, _pgval_ca_nd)
			    VAR _totalval_ca = IF(NOT ISFILTERED(orbis_dimension_01[customer]), _totalval_ca_default, _totalval_ca_nd)
			    VAR res_ca = DIVIDE(_pgval_ca, _totalval_ca, BLANK())
			    ----------------------------------------------------------------------------------------
			    ------------------------------------------FrontShop-------------------------------------
			    VAR _pgval_fs = CALCULATE([Value PXM], ALL(orbis_dimension_01[DataType]), orbis_dimension_01[DataType] in {"IQVIA_FRONTSHOP"})
			    VAR _totalval_fs = CALCULATE([Value PXM], ALL(orbis_dimension_01[Segment]), ALL(orbis_dimension_01[P&G Flag]), ALL(orbis_dimension_01[DataType]), orbis_dimension_01[DataType] in {"IQVIA_FRONTSHOP"})
			    VAR res_fb = DIVIDE(_pgval_fs, _totalval_fs, BLANK())
			    ---------------------------------------------------------------------------------------
			    ------------------------------------------Backshop-------------------------------------
			    VAR _pgval_bs = CALCULATE([Value PXM], ALL(orbis_dimension_01[DataType]), orbis_dimension_01[DataType] in { "IQVIA_BACKSHOP"})
			    VAR _totalval_bs = CALCULATE([Value PXM], ALL(orbis_dimension_01[Segment]), ALL(orbis_dimension_01[P&G Flag]), ALL(orbis_dimension_01[DataType]), orbis_dimension_01[DataType] in {"IQVIA_BACKSHOP"})
			    // VAR res_fb = DIVIDE(_pgval_bs, _totalval_bs, BLANK())
			    ----------------------------------------------------------------------------------------------
			    ----------------------------------------Total----------------------------------------------------
			    VAR _pgval = SWITCH(TRUE(), 
			            SELECTEDVALUE(orbis_dimension_01[DataType]) in {"IQVIA_CONSUMERAISLE"}, _pgval_ca, 
			            SELECTEDVALUE(orbis_dimension_01[DataType]) in {"IQVIA_FRONTSHOP"}, _pgval_fs, 
			            SELECTEDVALUE(orbis_dimension_01[DataType]) in {"IQVIA_BACKSHOP"}, _pgval_bs,
			            _pgval_ca+_pgval_fs+_pgval_bs
			            )
			
			    VAR _totalval = SWITCH(TRUE(), 
			            SELECTEDVALUE(orbis_dimension_01[DataType]) in {"IQVIA_CONSUMERAISLE"}, _totalval_ca, 
			            SELECTEDVALUE(orbis_dimension_01[DataType]) in {"IQVIA_FRONTSHOP"}, _totalval_fs, 
			            SELECTEDVALUE(orbis_dimension_01[DataType]) in {"IQVIA_BACKSHOP"}, _totalval_bs,
			            _totalval_ca+_totalval_fs+_totalval_bs
			            )
			
			
			    VAR res1 = DIVIDE(_pgval, _totalval, BLANK()) 
			    RETURN
			    res1
			    // _pgval
			    // _totalval
			
			VAR _res_segpage = 
			    VAR _pgval_ca_default =  CALCULATE([Value PXM], ALL(orbis_dimension_01[customer]), orbis_dimension_01[customer] = "TOTAL TD/ST")
			    VAR _totalval_ca_default = CALCULATE([Value PXM], ALL(orbis_dimension_01[Segment]), ALL(orbis_dimension_01[P&G Flag]), ALL(orbis_dimension_01[customer]), orbis_dimension_01[customer] = "TOTAL TD/ST")
			
			    VAR _pgval_ca_nd =  CALCULATE([Value PXM], ALL(orbis_dimension_01[DataType]))
			    VAR _totalval_ca_nd = CALCULATE([Value PXM], ALL(orbis_dimension_01[Segment]), ALL(orbis_dimension_01[P&G Flag]), ALL(orbis_dimension_01[DataType]))
			    ------------------------------------------  Consumer Aisle --------------------------------------
			    VAR _pgval_ca = IF(NOT ISFILTERED(orbis_dimension_01[customer]), _pgval_ca_default, _pgval_ca_nd)
			    VAR _totalval_ca = IF(NOT ISFILTERED(orbis_dimension_01[customer]), _totalval_ca_default, _totalval_ca_nd)
			    VAR res_ca = DIVIDE(_pgval_ca, _totalval_ca, BLANK())
			    ----------------------------------------------------------------------------------------
			    ------------------------------------------FrontShop-------------------------------------
			    VAR _pgval_fs = CALCULATE([Value PXM], ALL(orbis_dimension_01[DataType]), orbis_dimension_01[DataType] in {"IQVIA_FRONTSHOP"})
			    VAR _totalval_fs = CALCULATE([Value PXM], ALL(orbis_dimension_01[Segment]), ALL(orbis_dimension_01[P&G Flag]), ALL(orbis_dimension_01[DataType]), orbis_dimension_01[DataType] in {"IQVIA_FRONTSHOP"})
			    VAR res_fb = DIVIDE(_pgval_fs, _totalval_fs, BLANK())
			    ---------------------------------------------------------------------------------------
			    ------------------------------------------Backshop-------------------------------------
			    VAR _pgval_bs = CALCULATE([Value PXM], ALL(orbis_dimension_01[DataType]), orbis_dimension_01[DataType] in { "IQVIA_BACKSHOP"})
			    VAR _totalval_bs = CALCULATE([Value PXM], ALL(orbis_dimension_01[Segment]), ALL(orbis_dimension_01[P&G Flag]), ALL(orbis_dimension_01[DataType]), orbis_dimension_01[DataType] in {"IQVIA_BACKSHOP"})
			    // VAR res_fb = DIVIDE(_pgval_bs, _totalval_bs, BLANK())
			    ----------------------------------------------------------------------------------------------
			    ----------------------------------------Total----------------------------------------------------
			    VAR _pgval = SWITCH(TRUE(), 
			            SELECTEDVALUE(orbis_dimension_01[DataType]) in {"IQVIA_CONSUMERAISLE"}, _pgval_ca, 
			            SELECTEDVALUE(orbis_dimension_01[DataType]) in {"IQVIA_FRONTSHOP"}, _pgval_fs, 
			            SELECTEDVALUE(orbis_dimension_01[DataType]) in {"IQVIA_BACKSHOP"}, _pgval_bs,
			            _pgval_ca+_pgval_fs+_pgval_bs
			            )
			
			    VAR _totalval = SWITCH(TRUE(), 
			            SELECTEDVALUE(orbis_dimension_01[DataType]) in {"IQVIA_CONSUMERAISLE"}, _totalval_ca, 
			            SELECTEDVALUE(orbis_dimension_01[DataType]) in {"IQVIA_FRONTSHOP"}, _totalval_fs, 
			            SELECTEDVALUE(orbis_dimension_01[DataType]) in {"IQVIA_BACKSHOP"}, _totalval_bs,
			            _totalval_ca+_totalval_fs+_totalval_bs
			            )
			
			
			    VAR res2 = DIVIDE(_pgval, _totalval, BLANK()) 
			    RETURN
			    res2
			
			RETURN
			SWITCH(TRUE(),
			ISINSCOPE(orbis_dimension_01[category]) && ISINSCOPE(orbis_dimension_01[Brand]) && ISINSCOPE(orbis_dimension_01[Segment]) && NOT ISINSCOPE(orbis_dimension_01[Product]),
			_res_sharepage,
			_res_segpage)
			```
		lineageTag: 3e897439-ac96-4a2b-9e42-d6549e3ab9ac

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'SKU Value Salience' = ```
			
			VAR _pgval_ca_default =
			    CALCULATE (
			        [Value PXM],
			        ALL ( orbis_dimension_01[customer] ),
			        orbis_dimension_01[customer] = "TOTAL TD/ST"
			    )
			VAR _totalval_ca_default =
			    CALCULATE (
			        [Value PXM],
			        ALL ( orbis_dimension_01[Brand] ),
			        ALL ( orbis_dimension_01[Product] ),
			        ALL ( orbis_dimension_01[P&G Flag] ),
			        ALL ( orbis_dimension_01[customer] ),
			        orbis_dimension_01[customer] = "TOTAL TD/ST"
			    )
			VAR _pgval_ca_nd =
			    CALCULATE ( [Value PXM], ALL ( orbis_dimension_01[DataType] ) )
			VAR _totalval_ca_nd =
			    CALCULATE (
			        [Value PXM],
			        ALL ( orbis_dimension_01[Brand] ),
			        ALL ( orbis_dimension_01[Product] ),
			        ALL ( orbis_dimension_01[P&G Flag] ),
			        ALL ( orbis_dimension_01[DataType] )
			    ) ------------------------------------------  Consumer Aisle --------------------------------------
			VAR _pgval_ca =
			    IF (
			        NOT ISFILTERED ( orbis_dimension_01[customer] ),
			        _pgval_ca_default,
			        _pgval_ca_nd
			    )
			VAR _totalval_ca =
			    IF (
			        NOT ISFILTERED ( orbis_dimension_01[customer] ),
			        _totalval_ca_default,
			        _totalval_ca_nd
			    )
			VAR res_ca =
			    DIVIDE ( _pgval_ca, _totalval_ca, BLANK () ) -------------------------------------------------------------------------------------------------
			------------------------------------------FrontShop-------------------------------------
			VAR _pgval_fs =
			    CALCULATE (
			        [Value PXM],
			        ALL ( orbis_dimension_01[DataType] ),
			        orbis_dimension_01[DataType] IN { "IQVIA_FRONTSHOP" }
			    )
			VAR _totalval_fs =
			    CALCULATE (
			        [Value PXM],
			        ALL ( orbis_dimension_01[Brand] ),
			        ALL ( orbis_dimension_01[Product] ),
			        ALL ( orbis_dimension_01[P&G Flag] ),
			        ALL ( orbis_dimension_01[DataType] ),
			        orbis_dimension_01[DataType] IN { "IQVIA_FRONTSHOP" }
			    )
			VAR res_fb =
			    DIVIDE ( _pgval_fs, _totalval_fs, BLANK () ) -------------------------------------------------------------------------------------------------
			------------------------------------------Backshop-------------------------------------
			VAR _pgval_bs =
			    CALCULATE (
			        [Value PXM],
			        ALL ( orbis_dimension_01[DataType] ),
			        orbis_dimension_01[DataType] IN { "IQVIA_BACKSHOP" }
			    )
			VAR _totalval_bs =
			    CALCULATE (
			        [Value PXM],
			        ALL ( orbis_dimension_01[Brand] ),
			        ALL ( orbis_dimension_01[Product] ),
			        ALL ( orbis_dimension_01[P&G Flag] ),
			        ALL ( orbis_dimension_01[DataType] ),
			        orbis_dimension_01[DataType] IN { "IQVIA_BACKSHOP" }
			    ) // VAR res_fb = DIVIDE(_pgval_bs, _totalval_bs, BLANK())
			-------------------------------------------------------------------------------------------------
			----------------------------------------Total----------------------------------------------------
			VAR _pgval =
			    SWITCH (
			        TRUE (),
			        SELECTEDVALUE ( orbis_dimension_01[DataType] ) IN { "IQVIA_CONSUMERAISLE" }, _pgval_ca,
			        SELECTEDVALUE ( orbis_dimension_01[DataType] ) IN { "IQVIA_FRONTSHOP" }, _pgval_fs,
			        SELECTEDVALUE ( orbis_dimension_01[DataType] ) IN { "IQVIA_BACKSHOP" }, _pgval_bs,
			        _pgval_ca + _pgval_fs + _pgval_bs
			    )
			VAR _totalval =
			    SWITCH (
			        TRUE (),
			        SELECTEDVALUE ( orbis_dimension_01[DataType] ) IN { "IQVIA_CONSUMERAISLE" }, _totalval_ca,
			        SELECTEDVALUE ( orbis_dimension_01[DataType] ) IN { "IQVIA_FRONTSHOP" }, _totalval_fs,
			        SELECTEDVALUE ( orbis_dimension_01[DataType] ) IN { "IQVIA_BACKSHOP" }, _totalval_bs,
			        _totalval_ca + _totalval_fs + _totalval_bs
			    )
			VAR res =
			    DIVIDE ( _pgval, _totalval, BLANK () )
			RETURN
			    res
			    // _totalval
			
			```
		lineageTag: 8e19201d-c43f-4d99-8eed-b17896cae0c6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

