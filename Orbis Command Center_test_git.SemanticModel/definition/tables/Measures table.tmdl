	measure 'Shipment Order GIV Unfiltered Test' =
			
			CALCULATE (
			    [Shipment Order GIV],
			    REMOVEFILTERS ( DateTable ),
			    REMOVEFILTERS ( 'Slicer Month Year' )
			    // REMOVEFILTERS ( 'Time Period' ),
