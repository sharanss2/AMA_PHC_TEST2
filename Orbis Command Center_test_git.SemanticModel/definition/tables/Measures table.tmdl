	measure 'Shipments MSU Base' =
			
			[Shipment Order MSU]
		lineageTag: e7a80ec9-e042-4454-997f-e8580f49e1b9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Shipments Value PXM Page' =
			
			VAR _SelectedPeriod =
			    SELECTEDVALUE ( 'Time Period'[Period] )
			
			VAR _SlicerDate =
			    MAX ( 'Slicer Month Year'[Date] )
			
			VAR _CalendarDate =
			    MAX ( DateTable[Date] )
			
			VAR _CurrentMonthStart =
			    DATE ( YEAR ( TODAY() ), MONTH ( TODAY() ), 1 )
			
			VAR _SelectedMonthStart =
			    DATE ( YEAR ( _SlicerDate ), MONTH ( _SlicerDate ), 1 )
			
			VAR _MaxDate =
			    IF (
			        ISFILTERED ( 'Slicer Month Year' ),
			        IF (
			            _SelectedMonthStart = _CurrentMonthStart,
			            EOMONTH ( _SlicerDate, -1 ),
			            EOMONTH ( _SlicerDate, 0 )
			        ),
			        EOMONTH ( _CalendarDate, 0 )
			    )
			
			RETURN
			SWITCH (
			    TRUE (),
			
			    _SelectedPeriod = "Current Month",
			        IF (
			            SELECTEDVALUE ( 'Slicer Month Year'[Current Month Year] ) = "Current Month",
			            CALCULATE ( [Shipments Value Base], DATESMTD ( DateTable[Date] ) ),
			            BLANK()
			        ),
			
			    _SelectedPeriod = "P1M",
			        CALCULATE (
			            [Shipments Value Base],
			            DATESINPERIOD ( DateTable[Date], _MaxDate, -1, MONTH )
			        ),
			
			    _SelectedPeriod = "P3M",
			        CALCULATE (
			            [Shipments Value Base],
			            DATESINPERIOD ( DateTable[Date], _MaxDate, -3, MONTH )
			        ),
			
			    _SelectedPeriod = "P6M",
			        CALCULATE (
			            [Shipments Value Base],
			            DATESINPERIOD ( DateTable[Date], _MaxDate, -6, MONTH )
			        ),
			
			    _SelectedPeriod = "P12M",
			        CALCULATE (
			            [Shipments Value Base],
			            DATESINPERIOD ( DateTable[Date], _MaxDate, -12, MONTH )
			        ),
			
			    _SelectedPeriod = "MTD",
			        CALCULATE ( [Shipments Value Base], DATESMTD ( DateTable[Date] ) ),
			
			    _SelectedPeriod = "QTD",
