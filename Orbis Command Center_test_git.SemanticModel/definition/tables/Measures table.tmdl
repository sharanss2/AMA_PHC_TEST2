		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'IYA Visibility Filter IQVIA' = ```
			
			VAR SelectedDate = 
			    IF ( 
			        ISFILTERED('Slicer Month Year'), 
			        MIN('Slicer Month Year'[Date]), -- Use the end of the month from the slicer
			        MIN(DateTable[Date])     -- Fallback to default behavior
			    )
			
			// VAR SelectedDate = MAX('Slicer Month Year'[Date]) -- Or your Period End Date
			VAR SelectedPeriod = SELECTEDVALUE('Time Period'[Period]) -- e.g., "FYTD", "P12M"
			
			RETURN
			SWITCH( TRUE(),
			    SelectedPeriod = "FYTD" && SelectedDate <= DATE(2025, 8, 1), 0,
			    SelectedPeriod = "P12M" && SelectedDate <= DATE(2026, 4, 1), 0,
			    SelectedPeriod = "P6M"  && SelectedDate <= DATE(2025, 10, 1), 0,
			    SelectedPeriod = "P3M"  && SelectedDate <= DATE(2025, 7, 1), 0,
			    SelectedPeriod = "P1M"  && SelectedDate <= DATE(2025, 5, 1), 0,
			    1 -- Default to visible
			)
			```
		formatString: 0
		lineageTag: 3be6a881-13e8-4ca5-a104-4b7552892093

