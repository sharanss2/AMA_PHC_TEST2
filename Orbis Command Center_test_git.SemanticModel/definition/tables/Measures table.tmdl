			//     /* MTD */
			//     _SelectedPeriod = "MTD",
			//         CALCULATE (
			//             [Shipments LY],
			//             DATESMTD ( DateTable[Date] )
			//         ),
			
			//     /* QTD */
			//     _SelectedPeriod = "QTD",
			//         CALCULATE (
			//             [Shipments LY],
			//             DATESQTD ( DateTable[Date] )
			//         ),
			
			//     /* FYTD */
			//     // _SelectedPeriod = "FYTD",
			//     //     CALCULATE (
			//     //         [Shipments],
			//     //         DATESYTD (
			//     //             DateTable[Date],
			//     //             "06/30"   /* change if fiscal year end is different */
			//     //         )
			//     //     ),
			
			//                _SelectedPeriod = "FYTD",
			//         CALCULATE (
