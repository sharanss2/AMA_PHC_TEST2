	measure 'Value PXM' = ```
			
			VAR _SelectedPeriod =
			    SELECTEDVALUE ( 'Time Period'[Period] )
			
			VAR _SlicerDate = MAX('Slicer Month Year'[Date])
			VAR _CalendarDate = MAX(DateTable[Date])
			VAR _MaxDate = 
			    IF ( 
			        ISFILTERED('Slicer Month Year'), 
			        EOMONTH(_SlicerDate, 0), -- Use the end of the month from the slicer
			        EOMONTH(_CalendarDate, 0)     -- Fallback to default behavior
			    )
			VAR _SelectedDate = 
			    IF ( 
			        ISFILTERED('Slicer Month Year'), 
			        EOMONTH(_SlicerDate, 0), -- Use the end of the month from the slicer
			        EOMONTH(_CalendarDate, 0)     -- Fallback to default behavior
			    )
			RETURN
			SWITCH (    
			    TRUE(),
			
			        _SelectedPeriod = "Selected Month",
			        CALCULATE (
			            [Value],
			            DATESINPERIOD (
			                DateTable[Date],
			                _SelectedDate,
			                -1,
			                MONTH
			            )
			        ),
			    
			
			    /* P1M */
			    _SelectedPeriod = "P1M",
			        CALCULATE (
			            [Value],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -1,
			                MONTH
			            )
			        ),
			
			    /* P3M */
			    _SelectedPeriod = "P3M",
			        CALCULATE (
			           [Value],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -3,
			                MONTH
			            )
			        ),
			
			    /* P6M */
			    _SelectedPeriod = "P6M",
			        CALCULATE (
			            [Value],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -6,
			                MONTH
			            )
			        ),
			
			    /* P12M */
			    _SelectedPeriod = "P12M",
			        CALCULATE (
			            [Value],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -12,
			                MONTH
			            )
			        ),
			
			    /* MTD */
			    _SelectedPeriod = "MTD",
			        CALCULATE (
			            [Value],
			            DATESMTD ( DateTable[Date] )
			        ),
			
			    /* QTD */
			    _SelectedPeriod = "QTD",
			        CALCULATE (
			            [Value],
			            DATESQTD ( DateTable[Date] )
			        ),
			
			    /* FYTD */
			    // _SelectedPeriod = "FYTD",
			    //     CALCULATE (
			    //         [Value],
			    //         DATESYTD (
			    //             DateTable[Date],
			    //             "06/30"   /* change if fiscal year end is different */
			    //         )
			    //     ),
			
			        _SelectedPeriod = "FYTD",
			        CALCULATE (
			            [Value],
			            CALCULATETABLE (
			                DATESYTD ( DateTable[Date], "06/30" ),
			                DateTable[Date] = _MaxDate
			            )
			        ),
			
			    /* Default fallback */
			    [Value]
			)
			
			```
		lineageTag: 91eece09-fe7b-4741-9781-6364932a66e9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Volume (Units) PXM' = ```
			
			VAR _SelectedPeriod =
			    SELECTEDVALUE ( 'Time Period'[Period] )
			
			VAR _SlicerDate = MAX('Slicer Month Year'[Date])
			VAR _CalendarDate = MAX(DateTable[Date])
			VAR _MaxDate = 
			    IF ( 
			        ISFILTERED('Slicer Month Year'), 
			        EOMONTH(_SlicerDate, 0), -- Use the end of the month from the slicer
			        EOMONTH(_CalendarDate, 0)     -- Fallback to default behavior
			    )
			VAR _SelectedDate = 
			    IF ( 
			        ISFILTERED('Slicer Month Year'), 
			        EOMONTH(_SlicerDate, 0), -- Use the end of the month from the slicer
			        EOMONTH(_CalendarDate, 0)     -- Fallback to default behavior
			    )
			
			RETURN
			SWITCH (    
			    TRUE(),
			
			    /* Selected Month */
			    _SelectedPeriod = "Selected Month",
			        CALCULATE (
			            [Volume (Units)],
			            DATESINPERIOD (
			                DateTable[Date],
			                _SelectedDate,
			                -1,
			                MONTH
			            )
			        ),
			
			    /* P1M */
			    _SelectedPeriod = "P1M",
			        CALCULATE (
			            [Volume (Units)],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -1,
			                MONTH
			            )
			        ),
			
			    /* P3M */
			    _SelectedPeriod = "P3M",
			        CALCULATE (
			           [Volume (Units)],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -3,
			                MONTH
			            )
			        ),
			
			    /* P6M */
			    _SelectedPeriod = "P6M",
			        CALCULATE (
			            [Volume (Units)],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -6,
			                MONTH
			            )
			        ),
			
			    /* P12M */
			    _SelectedPeriod = "P12M",
			        CALCULATE (
			            [Volume (Units)],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -12,
			                MONTH
			            )
			        ),
			
			    /* MTD */
			    _SelectedPeriod = "MTD",
			        CALCULATE (
			            [Volume (Units)],
			            DATESMTD ( DateTable[Date] )
			        ),
			
			    /* QTD */
			    _SelectedPeriod = "QTD",
			        CALCULATE (
			            [Volume (Units)],
			            DATESQTD ( DateTable[Date] )
			        ),
			
			    /* FYTD */
			    // _SelectedPeriod = "FYTD",
			    //     CALCULATE (
			    //         [Volume],
			    //         DATESYTD (
			    //             DateTable[Date],
			    //             "06/30"   /* change if fiscal year end is different */
			    //         )
			    //     ),
			
			            _SelectedPeriod = "FYTD",
			        CALCULATE (
			            [Volume (Units)],
			            CALCULATETABLE (
			                DATESYTD ( DateTable[Date], "06/30" ),
			                DateTable[Date] = _MaxDate
			            )
			        ),
			
			    /* Default fallback */
			    [Volume (Units)]
			)
			
			```
		lineageTag: e1dc5c48-9d5b-4fea-9a1e-3a9fd1cbfebc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Volume Share' = ```
			
			VAR _IsCustomerFiltered =
			    ISFILTERED(orbis_dimension_01[Customer])
			
			VAR _TotalCustomers =
			    CALCULATE(
			        DISTINCTCOUNT(orbis_dimension_01[Customer]),
			        ALL(orbis_dimension_01[Customer])
			    )
			
			VAR _SelectedCount =
			    COUNTROWS(VALUES(orbis_dimension_01[Customer]))
			
			VAR _UseTotalTDST =
			    NOT _IsCustomerFiltered || _SelectedCount = _TotalCustomers
			
			
			VAR _IsTDSTCategory =
			    SELECTEDVALUE(orbis_dimension_01[category]) 
			        IN { "COUGH & COLD", "VITAMINS & SUPPLEMENTS" }
			
			
			/* VALUE (NOW VOLUME) */
			VAR _val =
			    IF(
			        _UseTotalTDST && _IsTDSTCategory,
			        CALCULATE(
			            SWITCH( TRUE(),
			                ISINSCOPE(orbis_dimension_01[Product]), [Volume (Units) PXM],
			                ISINSCOPE(orbis_dimension_01[Brand]),   [Volume (Units) PXM],
			                ISINSCOPE(orbis_dimension_01[Segment]), [Volume (Units) PXM],
			                CALCULATE([Volume (Units) PXM], KEEPFILTERS(ALLSELECTED(orbis_dimension_01[category])))
			            ),
			            REMOVEFILTERS(orbis_dimension_01[Customer]),
			            orbis_dimension_01[Customer] = "TOTAL TD/ST"
			        ),
			        SWITCH( TRUE(),
			            ISINSCOPE(orbis_dimension_01[Product]), [Volume (Units) PXM],
			            ISINSCOPE(orbis_dimension_01[Brand]),   [Volume (Units) PXM],
			            ISINSCOPE(orbis_dimension_01[Segment]), [Volume (Units) PXM],
			            CALCULATE([Volume (Units) PXM], KEEPFILTERS(ALLSELECTED(orbis_dimension_01[category])))
			        )
			    )
			
			
			/* COMP */
			VAR _compval =
			    IF(
			        _UseTotalTDST && _IsTDSTCategory,
			        CALCULATE(
			            [Volume (Units) PXM],
			            REMOVEFILTERS(orbis_dimension_01[Brand]),
			            REMOVEFILTERS(orbis_dimension_01[Product]),
			            REMOVEFILTERS(orbis_dimension_01[Segment]),
			            REMOVEFILTERS(orbis_dimension_01[Customer]),
			            orbis_dimension_01[Customer] = "TOTAL TD/ST",
			            orbis_dimension_01[P&G Flag] = 0,
			            KEEPFILTERS('Time Period')
			        ),
			        CALCULATE(
			            [Volume (Units) PXM],
			            REMOVEFILTERS(orbis_dimension_01[Brand]),
			            REMOVEFILTERS(orbis_dimension_01[Product]),
			            REMOVEFILTERS(orbis_dimension_01[Segment]),
			            orbis_dimension_01[P&G Flag] = 0,
			            KEEPFILTERS('Time Period')
			        )
			    )
			
			
			/* PG */
			VAR _pgval =
			    IF(
			        _UseTotalTDST && _IsTDSTCategory,
			        CALCULATE(
			            [Volume (Units) PXM],
			            REMOVEFILTERS(orbis_dimension_01[Brand]),
			            REMOVEFILTERS(orbis_dimension_01[Product]),
			            REMOVEFILTERS(orbis_dimension_01[Segment]),
			            REMOVEFILTERS(orbis_dimension_01[Customer]),
			            orbis_dimension_01[Customer] = "TOTAL TD/ST",
			            orbis_dimension_01[P&G Flag] = 1,
			            KEEPFILTERS('Time Period')
			        ),
			        CALCULATE(
			            [Volume (Units) PXM],
			            REMOVEFILTERS(orbis_dimension_01[Brand]),
			            REMOVEFILTERS(orbis_dimension_01[Product]),
			            REMOVEFILTERS(orbis_dimension_01[Segment]),
			            orbis_dimension_01[P&G Flag] = 1,
			            KEEPFILTERS('Time Period')
			        )
			    )
			
			
			VAR _TotalMarket = _pgval + _compval
			
			
			/* LEVEL FLAGS */
			VAR _IsCategorySubtotal =
			    ISINSCOPE(orbis_dimension_01[category]) &&
			    NOT ISINSCOPE(orbis_dimension_01[Brand]) &&
			    NOT ISINSCOPE(orbis_dimension_01[Segment]) &&
			    NOT ISINSCOPE(orbis_dimension_01[Product])
			
			VAR _Issegment =
			    ISINSCOPE(orbis_dimension_01[Segment]) &&
			    NOT ISINSCOPE(orbis_dimension_01[Brand]) &&
			    NOT ISINSCOPE(orbis_dimension_01[Product])
			
			
			RETURN
			IF(
			    NOT ISBLANK(_val) && _val <> 0,
			    SWITCH( TRUE(),
			
			        -- SEGMENT LEVEL
			        _Issegment, [Segment Share]
			            // DIVIDE(
			            //     _val,
			            //     CALCULATE(
			            //         [Volume PXM],
			            //         ALL(orbis_dimension_01[Brand]),
			            //         ALL(orbis_dimension_01[Product])
			            //     )
			            // )
			            ,
			
			        -- CATEGORY SUBTOTAL
			        _IsCategorySubtotal,
			            DIVIDE(_pgval, _TotalMarket),
			
			        -- DEFAULT
			        DIVIDE(_val, _TotalMarket)
			    )
			)
			----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
			// VAR _IsCustomerFiltered =
			//     ISFILTERED(orbis_dimension_01[Customer])
			
			// VAR _TotalCustomers =
			//     CALCULATE(
			//         DISTINCTCOUNT(orbis_dimension_01[Customer]),
			//         ALL(orbis_dimension_01[Customer])
			//     )
			
			// VAR _SelectedCount =
			//     COUNTROWS(VALUES(orbis_dimension_01[Customer]))
			
			// VAR _UseTotalTDST =
			//     NOT _IsCustomerFiltered || _SelectedCount = _TotalCustomers
			
			
			// /* ===================== NUMERATOR ===================== */
			// VAR _val =
			//     IF(
			//         _UseTotalTDST,
			//         CALCULATE(
			//             SWITCH( TRUE(),
			//                 ISINSCOPE(orbis_dimension_01[Product]), [Volume PXM],
			//                 ISINSCOPE(orbis_dimension_01[Brand]), [Volume PXM],
			//                 ISINSCOPE(orbis_dimension_01[Segment]), [Volume PXM],
			//                 CALCULATE(
