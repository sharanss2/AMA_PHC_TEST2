			    IF(
			        ISINSCOPE('Time Period'[Period]),
			        rawsales,
			        SUMX(
			            VALUES('DateTable'[Month Year]),
			            IF(
			                [Show RTDX Month Range] = 1,
			                [RTDX Sales PXM],
