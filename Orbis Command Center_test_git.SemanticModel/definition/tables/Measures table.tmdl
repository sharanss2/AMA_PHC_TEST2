	measure 'Volume (MSU) PXM' = ```
			
			VAR _SelectedPeriod =
			    SELECTEDVALUE ( 'Time Period'[Period] )
			
			VAR _SlicerDate = MAX('Slicer Month Year'[Date])
			VAR _CalendarDate = MAX(DateTable[Date])
			VAR _MaxDate = 
			    IF ( 
			        ISFILTERED('Slicer Month Year'), 
			        EOMONTH(_SlicerDate, 0), -- Use the end of the month from the slicer
			        EOMONTH(_CalendarDate, 0)     -- Fallback to default behavior
			    )
			VAR _SelectedDate = 
			    IF ( 
			        ISFILTERED('Slicer Month Year'), 
			        EOMONTH(_SlicerDate, 0), -- Use the end of the month from the slicer
			        EOMONTH(_CalendarDate, 0)     -- Fallback to default behavior
			    )
			
			RETURN
			SWITCH (    
			    TRUE(),
			
			    /* Selected Month */
			    _SelectedPeriod = "Selected Month",
			        CALCULATE (
			            [Volume (MSU)],
			            DATESINPERIOD (
			                DateTable[Date],
			                _SelectedDate,
			                -1,
			                MONTH
			            )
			        ),
			
			    /* P1M */
			    _SelectedPeriod = "P1M",
			        CALCULATE (
			            [Volume (MSU)],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -1,
			                MONTH
			            )
			        ),
			
			    /* P3M */
			    _SelectedPeriod = "P3M",
			        CALCULATE (
			           [Volume (MSU)],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -3,
			                MONTH
			            )
			        ),
			
			    /* P6M */
			    _SelectedPeriod = "P6M",
			        CALCULATE (
			            [Volume (MSU)],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -6,
			                MONTH
			            )
			        ),
			
			    /* P12M */
			    _SelectedPeriod = "P12M",
			        CALCULATE (
			            [Volume (MSU)],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -12,
			                MONTH
			            )
			        ),
			
			    /* MTD */
			    _SelectedPeriod = "MTD",
			        CALCULATE (
			            [Volume (MSU)],
			            DATESMTD ( DateTable[Date] )
			        ),
			
			    /* QTD */
			    _SelectedPeriod = "QTD",
			        CALCULATE (
			            [Volume (MSU)],
			            DATESQTD ( DateTable[Date] )
			        ),
			
			    /* FYTD */
			    // _SelectedPeriod = "FYTD",
			    //     CALCULATE (
			    //         [Volume],
			    //         DATESYTD (
			    //             DateTable[Date],
			    //             "06/30"   /* change if fiscal year end is different */
			    //         )
			    //     ),
			
			            _SelectedPeriod = "FYTD",
			        CALCULATE (
			            [Volume (MSU)],
			            CALCULATETABLE (
			                DATESYTD ( DateTable[Date], "06/30" ),
			                DateTable[Date] = _MaxDate
			            )
			        ),
			
			    /* Default fallback */
			    [Volume (MSU)]
			)
			
			```
		lineageTag: 6c8a4ab1-3818-4e85-b2d2-afc40a0282b2

