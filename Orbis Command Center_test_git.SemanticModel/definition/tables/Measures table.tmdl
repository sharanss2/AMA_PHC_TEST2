	measure 'Filtered Shipments IYA' = ```
			
			
			VAR VisibleSales =
			    IF(
			        ISINSCOPE('Time Period'[Period]),
			        IF(
			            [Sales Visibility Filter POS & Shipments] = 0,
			            BLANK(),
			            [Shipments PXM]
			        ),
			        SUMX(
			            VALUES('DateTable'[Month Year]),
			            IF(
			                [Show Shipment Month Range] = 1,
			                [Shipments PXM],
			                BLANK()
			            )
			        )
			    )
			
			VAR VisibleLYSales =
			    IF(
			        ISINSCOPE('Time Period'[Period]),
			        IF(
			            [Sales Visibility Filter POS & Shipments] = 0,
			            BLANK(),
			            [Shipments LY PXM]
			        ),
			        SUMX(
			            VALUES('DateTable'[Month Year]),
			            IF(
			                [Show Shipment Month Range] = 1,
			                [Shipments LY PXM],
			                BLANK()
			            )
			        )
			    )
			
			RETURN
			IF(
			    ISBLANK(VisibleSales) || ISBLANK(VisibleLYSales),
			    BLANK(),
			    DIVIDE(VisibleSales, VisibleLYSales) * 100
			)
