	measure 'IQVIA Sales LY' =
			
			VAR MaxDateWithData = CALCULATE(MAX(iqvia_data_01[period_end_date]), ALL(iqvia_data_01))
			RETURN
			SUMX(
			    KEEPFILTERS(VALUES(DateTable[Date])),
			    IF (
			        DateTable[Date] <= MaxDateWithData,
			        CALCULATE (
			            [IQVIA Sales],
			            DATEADD ( DateTable[Date], -1, YEAR )
			        ),
			        BLANK()
			    )
			)
		lineageTag: 451072cd-368a-44f1-aa3a-a76c3e7a5621

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'IQVIA Sales PXM' = ```
			
			VAR _SelectedPeriod =
			    SELECTEDVALUE ( 'Time Period'[Period] )
			
			// VAR _MaxDate =
			//    MAX ( DateTable[Date] )
			VAR _SlicerDate = MAX('Slicer Month Year'[Date])
			VAR _CalendarDate = MAX(DateTable[Date])
			VAR _MaxDate = 
			    IF ( 
			        ISFILTERED('Slicer Month Year'), 
			        EOMONTH(_SlicerDate, 0), -- Use the end of the month from the slicer
			        EOMONTH(_CalendarDate, 0)     -- Fallback to default behavior
			    )
			
			RETURN
			// _MaxDate
			SWITCH (    
			    TRUE(),
			
			    /* P1M */
			    _SelectedPeriod = "P1M",
			        CALCULATE (
			            [IQVIA Sales],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -1,
			                MONTH
			            )
			        ),
			
			    /* P3M */
			    _SelectedPeriod = "P3M",
			        CALCULATE (
			           [IQVIA Sales],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -3,
			                MONTH
			            )
			        ),
			
			    /* P6M */
			    _SelectedPeriod = "P6M",
			        CALCULATE (
			            [IQVIA Sales],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -6,
			                MONTH
			            )
			        ),
			
			    /* P12M */
			    _SelectedPeriod = "P12M",
			        CALCULATE (
			            [IQVIA Sales],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -12,
			                MONTH
			            )
			        ),
			
			    /* MTD */
			    _SelectedPeriod = "MTD",
			        CALCULATE (
			            [IQVIA Sales],
			            DATESMTD ( DateTable[Date] )
			        ),
			
			    /* QTD */
			    _SelectedPeriod = "QTD",
			        CALCULATE (
			            [IQVIA Sales],
			            DATESQTD ( DateTable[Date] )
			        ),
			
			    /* FYTD */
			    // _SelectedPeriod = "FYTD",
			    //     CALCULATE (
			    //         [IQVIA Sales],
			    //         DATESYTD (
			    //             DateTable[Date],
			    //             "06/30"   /* change if fiscal year end is different */
			    //         )
			    //     ),
			
			           _SelectedPeriod = "FYTD",
			        CALCULATE (
			            [IQVIA Sales],
			            CALCULATETABLE (
			                DATESYTD ( DateTable[Date], "06/30" ),
			                DateTable[Date] = _MaxDate
			            )
			        ),
			
			    /* Default fallback */
			    [IQVIA Sales]
			)
			
			```
		lineageTag: 248dacb6-bb51-4b05-bc79-087fb579fe84

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'IQVIA Sales LY PXM' = ```
			
			VAR _SelectedPeriod =
			    SELECTEDVALUE ( 'Time Period'[Period] )
			
			// VAR _MaxDate =
			//    MAX ( DateTable[Date] )
			VAR _SlicerDate = MAX('Slicer Month Year'[Date])
			VAR _CalendarDate = MAX(DateTable[Date])
			VAR _MaxDate = 
			    IF ( 
			        ISFILTERED('Slicer Month Year'), 
			        EOMONTH(_SlicerDate, 0), -- Use the end of the month from the slicer
			        EOMONTH(_CalendarDate, 0)     -- Fallback to default behavior
			    )
			
			RETURN
			// _MaxDate
			SWITCH (    
			    TRUE(),
			
			    /* P1M */
			    _SelectedPeriod = "P1M",
			        CALCULATE (
			            [IQVIA Sales LY],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -1,
			                MONTH
			            )
			        ),
			
			    /* P3M */
			    _SelectedPeriod = "P3M",
			        CALCULATE (
			           [IQVIA Sales LY],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -3,
			                MONTH
			            )
			        ),
			
			    /* P6M */
			    _SelectedPeriod = "P6M",
			        CALCULATE (
			            [IQVIA Sales LY],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -6,
			                MONTH
			            )
			        ),
			
			    /* P12M */
			    _SelectedPeriod = "P12M",
			        CALCULATE (
			            [IQVIA Sales LY],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -12,
			                MONTH
			            )
			        ),
			
			    /* MTD */
			    _SelectedPeriod = "MTD",
			        CALCULATE (
			            [IQVIA Sales LY],
			            DATESMTD ( DateTable[Date] )
			        ),
			
			    /* QTD */
			    _SelectedPeriod = "QTD",
			        CALCULATE (
			            [IQVIA Sales LY],
			            DATESQTD ( DateTable[Date] )
			        ),
			
			    /* FYTD */
			    // _SelectedPeriod = "FYTD",
			    //     CALCULATE (
			    //         [IQVIA Sales LY],
			    //         DATESYTD (
			    //             DateTable[Date],
			    //             "06/30"   /* change if fiscal year end is different */
			    //         )
			    //     ),
			
			       _SelectedPeriod = "FYTD",
			        CALCULATE (
			            [IQVIA Sales LY],
			            CALCULATETABLE (
			                DATESYTD ( DateTable[Date], "06/30" ),
			                DateTable[Date] = _MaxDate
			            )
			        ),
			
			    /* Default fallback */
			    [IQVIA Sales LY]
			)
			```
		lineageTag: e542392e-feec-4939-9df8-cd44da7aca75

		annotation PBI_FormatHint = {"isGeneralNumber":true}

