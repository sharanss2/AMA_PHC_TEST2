	measure 'POS Sales LY Current Month Daily - Customer View' =
			
			VAR LatestDate =
			    [Latest POS Daily Date Current Month - Customer View]
			VAR SelectedCustomers =
			    SUMMARIZECOLUMNS(  orbis_dimension_01[customer],
			     orbis_dimension_01[Brand],
			     orbis_dimension_01[Segment],
			     orbis_dimension_01[Product])
			VAR StartDateLY =
			    IF (
			        ISBLANK ( LatestDate ),
			        BLANK(),
			        DATE ( YEAR ( LatestDate ) - 1, MONTH ( LatestDate ), 1 )
			    )
			VAR EndDateLY =
			    IF (
			        ISBLANK ( LatestDate ),
			        BLANK(),
			        DATE ( YEAR ( LatestDate ) - 1, MONTH ( LatestDate ), DAY ( LatestDate ) )
			    )
			RETURN
			IF (
			    ISBLANK ( LatestDate ),
			    BLANK(),
			    CALCULATE (
			        [POS Sales Daily],
			        REMOVEFILTERS ( DateTable ),
			        FILTER (
			            ALL ( pos_daily[period_end_date] ),
			            pos_daily[period_end_date] >= StartDateLY
			                && pos_daily[period_end_date] <= EndDateLY
			        ),
			        TREATAS ( SelectedCustomers, pos_daily[Customer],pos_daily[Brand],pos_daily[Segment],
			         pos_daily[Product])
			    )
			)
