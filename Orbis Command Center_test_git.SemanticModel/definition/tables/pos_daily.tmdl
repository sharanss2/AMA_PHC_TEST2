table pos_daily
	lineageTag: 55192c03-d026-4117-8fdf-deb2d94973eb

	measure 'POS Sales Daily' =
			
			VAR val = SUM ( pos_daily[Sales] )
			VAR vol = SUM ( pos_daily[Sales_MSU] )
			VAR units = SUM ( pos_daily[Units_Sold] )
			RETURN
			    SWITCH (
			        SELECTEDVALUE ( 'Switcher Table'[Value/Volume] ),
			        "Value", val,
			        "Volume (MSU)", vol,
			        "Volume (Units)", units
			    )
		lineageTag: c978f255-e260-4e65-b24e-dca7ba125585

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Latest POS Daily Date Current Month' =
			
			CALCULATE (
			    MAX ( pos_daily[period_end_date] ),
			    FILTER (
			        ALL ( pos_daily[period_end_date] ),
			        YEAR ( pos_daily[period_end_date] ) = YEAR ( TODAY() )
			            && MONTH ( pos_daily[period_end_date] ) = MONTH ( TODAY() )
			    )
			)
		formatString: General Date
		lineageTag: b23a2757-b41d-4460-9383-49f9947f355a

	measure 'POS Sales Current Month Daily' =
			
			VAR LatestDate =
			    [Latest POS Daily Date Current Month]
			RETURN
			    CALCULATE (
			        [POS Sales Daily],
			        DATESBETWEEN (
			            DateTable[Date],
			            DATE ( YEAR ( LatestDate ), MONTH ( LatestDate ), 1 ),
			            LatestDate
			        )
			    )
		lineageTag: 5ddccfbe-61ab-4a8b-bb6a-eb83f8702972

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'POS Sales LY Current Month Daily' =
			
			VAR LatestDate =
			    [Latest POS Daily Date Current Month]
			RETURN
			    CALCULATE (
			        [POS Sales Daily],
			        DATESBETWEEN (
			            DateTable[Date],
			            DATE ( YEAR ( LatestDate ) - 1, MONTH ( LatestDate ), 1 ),
			            DATE ( YEAR ( LatestDate ) - 1, MONTH ( LatestDate ), DAY ( LatestDate ) )
			        )
			    )
		lineageTag: 767f5d22-a90c-4b10-8594-4be4841b1938

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'POS IYA PXM Fixed' =
			
			VAR _SelectedPeriod =
			    SELECTEDVALUE ( 'Time Period'[Period] )
			
			VAR _IsCurrentMonthSelected =
			    SELECTEDVALUE ( 'Slicer Month Year'[Current Month Year] ) = "Current Month"
			
			VAR _CurrentMonthIYA =
			    DIVIDE (
			        [POS Sales Current Month Daily],
			        [POS Sales LY Current Month Daily],
			        BLANK()
			    ) * 100
			
			VAR _StandardIYA =
			    DIVIDE ( [POS Sales PXM], [POS Sales LY PXM], BLANK() ) * 100
			
			RETURN
			IF (
			    [IYA Visibility Filter POS & Shipments] = 0,
			    BLANK(),
			    IF (
			        _SelectedPeriod = "Current Month" && _IsCurrentMonthSelected,
			        _CurrentMonthIYA,
			        _StandardIYA
			    )
			)
		lineageTag: be242b9c-4354-448e-ae94-bc185ff321d5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Latest POS Daily Date Current Month - Customer View' =
			
			VAR SelectedCustomers =
			    VALUES ( orbis_dimension_01[customer] )
			RETURN
			CALCULATE (
			    MAX ( pos_daily[period_end_date] ),
			    REMOVEFILTERS ( DateTable ),
			    FILTER (
			        ALL ( pos_daily[period_end_date] ),
			        YEAR ( pos_daily[period_end_date] ) = YEAR ( TODAY() )
			            && MONTH ( pos_daily[period_end_date] ) = MONTH ( TODAY() )
			    ),
			    TREATAS ( SelectedCustomers, pos_daily[Customer] )
			)
		formatString: General Date
		lineageTag: ed3801cb-6d40-467d-b5e1-f9e219a5aa54

