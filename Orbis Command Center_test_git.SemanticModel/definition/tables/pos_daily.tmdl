	measure 'POS Sales Current Month Daily - Customer View' = ```
			
			VAR LatestDate =
			    [Latest POS Daily Date Current Month - Customer View]
			VAR SelectedCustomers =
			    SUMMARIZECOLUMNS(  orbis_dimension_01[customer],
			     orbis_dimension_01[Brand],
			     orbis_dimension_01[Segment],
			     orbis_dimension_01[Product])
			
			    
			RETURN
			IF (
			    ISBLANK ( LatestDate ),
			    BLANK(),
			    CALCULATE (
			        [POS Sales Daily],
			        REMOVEFILTERS ( DateTable ),
			        FILTER (
			            ALL ( pos_daily[period_end_date] ),
			            pos_daily[period_end_date] >= DATE ( YEAR ( LatestDate ), MONTH ( LatestDate ), 1 )
			                && pos_daily[period_end_date] <= LatestDate
			        ),
			        TREATAS ( SelectedCustomers, pos_daily[Customer],pos_daily[Brand],pos_daily[Segment],pos_daily[Product] )
			    )
			)
			```
		lineageTag: 7a7f37cf-e324-44bf-97ea-8f4848ea1281

