	measure 'Show Item for Selected DataType TEST' =
			
			VAR HasExplicitDT =
			    ISFILTERED ( 'DataType Slicer'[DataType] )
			
			VAR SelectedDT =
			    VALUES ( 'DataType Slicer'[DataType] )
			
			VAR RowCountForDT =
			    IF (
			        HasExplicitDT,
			        CALCULATE (
			            COUNTROWS ( iqvia_all_04 ),
			            REMOVEFILTERS ( iqvia_all_04[DataType] ),
			            TREATAS ( SelectedDT, iqvia_all_04[DataType] )
			        ),
			        CALCULATE ( COUNTROWS ( iqvia_all_04 ) )
			    )
			RETURN
			    IF ( RowCountForDT > 0, 1, BLANK() )
		formatString: 0
		lineageTag: 6a21885e-5f2f-4a7a-b803-cb270947e066

	measure 'Show Matrix Row for Selected DataType TEST' =
			
			VAR RowValue =
			    CALCULATE (
			        [IQVIA Value PXM (Explicit DT) TEST],
			        REMOVEFILTERS ( 'Time Period' )
			    )
			RETURN
			    IF ( NOT ISBLANK ( RowValue ) && RowValue <> 0, 1, BLANK() )
		formatString: 0
		lineageTag: a3c4190a-13b0-4b52-9a05-46db57107910

	measure 'Show Category in Matrix for Selected DataType TEST' =
			
			
			VAR IsGrandTotalRow =
			    NOT ISINSCOPE ( orbis_dimension_01[Category] )
			
			VAR Cat =
			    SELECTEDVALUE ( orbis_dimension_01[Category] )
			
			VAR HasExplicitDT =
			    COUNTROWS ( ALLSELECTED ( 'DataType Slicer'[DataType] ) )
			        < COUNTROWS ( ALL ( 'DataType Slicer'[DataType] ) )
			
			VAR SelectedDT =
			    VALUES ( 'DataType Slicer'[DataType] )
			
			VAR IncludeCA =
			    NOT HasExplicitDT
			        || CONTAINS (
			            SelectedDT,
			            'DataType Slicer'[DataType], "IQVIA_CONSUMERAISLE"
			        )
			
			VAR IncludeFS =
			    NOT HasExplicitDT
			        || CONTAINS (
			            SelectedDT,
			            'DataType Slicer'[DataType], "IQVIA_FRONTSHOP"
			        )
			
			VAR IncludeBS =
			    NOT HasExplicitDT
			        || CONTAINS (
			            SelectedDT,
			            'DataType Slicer'[DataType], "IQVIA_BACKSHOP"
			        )
			
			VAR Allowed =
			    ( IncludeCA && Cat IN { "COUGH & COLD", "VITAMINS & SUPPLEMENTS" } )
			        || ( IncludeFS && Cat IN { "COUGH & COLD", "VITAMINS & SUPPLEMENTS" } )
			        || ( IncludeBS && Cat IN { "COUGH & COLD", "VITAMINS & SUPPLEMENTS", "NASAL DECONGESTANTS", "NERVE CARE" } )
			
			RETURN
			    IF (
			        IsGrandTotalRow,
			        1,
			        IF ( Allowed, 1, BLANK() )
			    )
		formatString: 0
		lineageTag: 46b4223b-de0a-45e0-b995-63234142a58c

