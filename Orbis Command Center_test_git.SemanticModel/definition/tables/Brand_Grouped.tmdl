	measure 'IQVIA Volume PXM (Explicit DT) TEST' =
			
			VAR HasExplicitDT =
			    ISFILTERED ( 'DataType Slicer'[DataType] )
			
			VAR SelectedDT =
			    VALUES ( 'DataType Slicer'[DataType] )
			
			VAR IncludeCA =
			    NOT HasExplicitDT
			        || CONTAINS (
			            SelectedDT,
			            'DataType Slicer'[DataType], "IQVIA_CONSUMERAISLE"
			        )
			
			VAR IncludeFS =
			    NOT HasExplicitDT
			        || CONTAINS (
			            SelectedDT,
			            'DataType Slicer'[DataType], "IQVIA_FRONTSHOP"
			        )
			
			VAR IncludeBS =
			    NOT HasExplicitDT
			        || CONTAINS (
			            SelectedDT,
			            'DataType Slicer'[DataType], "IQVIA_BACKSHOP"
			        )
			
			VAR CustomerFiltered =
			    ISFILTERED ( orbis_dimension_01[customer] )
			
			VAR CAValue =
			    IF (
			        IncludeCA,
			        IF (
			            CustomerFiltered,
			            CALCULATE (
			                [Volume (Units) PXM],
			                REMOVEFILTERS ( orbis_dimension_01[DataType] ),
			                KEEPFILTERS ( orbis_dimension_01[DataType] = "IQVIA_CONSUMERAISLE" )
			            ),
			            CALCULATE (
			                [Volume (Units) PXM],
			                REMOVEFILTERS ( orbis_dimension_01[customer], orbis_dimension_01[DataType] ),
			                KEEPFILTERS ( orbis_dimension_01[customer] = "TOTAL TD/ST" ),
			                KEEPFILTERS ( orbis_dimension_01[DataType] = "IQVIA_CONSUMERAISLE" )
			            )
			        ),
			        0
			    )
			
			VAR FSValue =
			    IF (
			        IncludeFS,
			        CALCULATE (
			            [Volume (Units) PXM],
			            REMOVEFILTERS ( orbis_dimension_01[DataType] ),
			            KEEPFILTERS ( orbis_dimension_01[DataType] = "IQVIA_FRONTSHOP" )
			        ),
			        0
			    )
			
			VAR BSValue =
			    IF (
			        IncludeBS,
			        CALCULATE (
			            [Volume (Units) PXM],
			            REMOVEFILTERS ( orbis_dimension_01[DataType] ),
			            KEEPFILTERS ( orbis_dimension_01[DataType] = "IQVIA_BACKSHOP" )
			        ),
			        0
			    )
			
			RETURN
			    CAValue + FSValue + BSValue
		lineageTag: 24542f42-9d22-4870-a591-e9f4b1d3710f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

