	measure 'Value Share new TEST' =
			
			SWITCH (
			    TRUE (),
			    ISINSCOPE ( orbis_dimension_01[Product] ), [SKU Value Share TEST],
			    ISINSCOPE ( orbis_dimension_01[Segment] ), [Segment Value Share TEST],
			    ISINSCOPE ( orbis_dimension_01[Brand] ), [Brand Value Share TEST],
			    ISINSCOPE ( orbis_dimension_01[PG Category] ), [P&G Category Value Share TEST],
			    ISINSCOPE ( orbis_dimension_01[Category] ), 1,
			    1
			)
		formatString: 0.0%;-0.0%;0.0%
