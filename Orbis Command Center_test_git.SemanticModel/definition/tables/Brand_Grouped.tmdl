	measure 'Shipments Visual MSU Compare' =
			
			CALCULATE (
			    [Shipment Order MSU],
			    REMOVEFILTERS ( 'Time Period' ),
			    REMOVEFILTERS ( orbis_dimension_01 ),
			
			    FILTER (
			        ALL ( shipmenets_data_07[Customer] ),
			        NOT ISFILTERED ( orbis_dimension_01[customer] )
			            || shipmenets_data_07[Customer] IN ALLSELECTED ( orbis_dimension_01[customer] )
			    ),
			
			    FILTER (
			        ALL ( shipmenets_data_07[Brand] ),
			        NOT ISFILTERED ( orbis_dimension_01[Brand] )
			            || shipmenets_data_07[Brand] IN ALLSELECTED ( orbis_dimension_01[Brand] )
			    ),
			
			    FILTER (
			        ALL ( shipmenets_data_07[Segment] ),
			        NOT ISFILTERED ( orbis_dimension_01[Segment] )
			            || shipmenets_data_07[Segment] IN ALLSELECTED ( orbis_dimension_01[Segment] )
			    ),
			
			    FILTER (
			        ALL ( shipmenets_data_07[Product] ),
			        NOT ISFILTERED ( orbis_dimension_01[Product] )
			            || shipmenets_data_07[Product] IN ALLSELECTED ( orbis_dimension_01[Product] )
			    ),
			
			    FILTER (
			        ALL ( shipmenets_data_07[Channel] ),
			        IF (
			            ISFILTERED ( orbis_dimension_01[Channel] ),
			            shipmenets_data_07[Channel] IN ALLSELECTED ( orbis_dimension_01[Channel] ),
			            shipmenets_data_07[Channel] IN { "DPP", "HSM" }
			        )
			    )
			)
		lineageTag: 75ae3055-c8ae-47ff-8b45-68a815203e29

		annotation PBI_FormatHint = {"isGeneralNumber":true}

