	column 'Current Month Year' = IF(DateTable[Year] = YEAR(TODAY()) && DateTable[Month Number] = MONTH(TODAY()), "Current Month", FORMAT(DateTable[Date], "MMMM, YYYY"))
		lineageTag: 2f3c147d-be2e-445a-b78a-e524a0df3eb9
		summarizeBy: none
		sortByColumn: 'Current Month Year Sort'

