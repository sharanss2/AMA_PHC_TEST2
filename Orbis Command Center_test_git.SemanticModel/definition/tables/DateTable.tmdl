	column 'Sort Order'
		formatString: 0
		lineageTag: e212eccf-a0b1-4359-9e07-07b5c9d7f4ea
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Sort Order]

		annotation SummarizationSetBy = Automatic

	column 'Current Month Year Sort' =
			
			VAR ThisYearMonth = DateTable[Year] * 100 + DateTable[Month Number]
			VAR CurrentYearMonth = YEAR(TODAY()) * 100 + MONTH(TODAY())
			RETURN
			IF(
			    ThisYearMonth = CurrentYearMonth,
			    CurrentYearMonth,
			    ThisYearMonth
			)
		formatString: 0
		lineageTag: 4caf20bd-27e4-49f8-b240-4657100fa74c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition DateTable = calculated
		mode: import
		source =
				
				// VAR BaseCalendar = CALENDARAUTO(4)
				// RETURN
				// GENERATE (
				//     BaseCalendar,
				//     VAR BaseDate = [Date]
				//     RETURN ROW (
				//         "Year", YEAR(BaseDate),
				//         "Month", FORMAT(BaseDate, "MMMM"),
				//         "Month Number", MONTH(BaseDate),
				//         "Quarter", "Q" & FORMAT(BaseDate, "Q"),
				//         "Fiscal Year", IF(MONTH(BaseDate) <= 6, YEAR(BaseDate), YEAR(BaseDate) + 1),
				//         "Month Year", FORMAT(BaseDate, "MMM-YY"),
				//         "RptMonthYear", INT( FORMAT([Date], "YYYYMM"))
				//     )
				// )
				ADDCOLUMNS (
				    CALENDAR (DATE(2022, 6, 1), EOMONTH(TODAY(), 0)),
				    "Year", YEAR([Date]),
				    "Month Number", MONTH([Date]),
				    "Month", FORMAT([Date], "MMM"),
				    "RptMonthYear", INT( FORMAT([Date], "YYYYMM")),
				    "Month Year", FORMAT([Date], "MMM YYYY"),
				    "Year-Month", FORMAT([Date], "YYYY-MM"),
				    "Sort Order", YEAR([Date]) * 100 + MONTH([Date])
				)

	annotation PBI_Id = f3cb2a23bbca4ce59dac5acbab3322df

