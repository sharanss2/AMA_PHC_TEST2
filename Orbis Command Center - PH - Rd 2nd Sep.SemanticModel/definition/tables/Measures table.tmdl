			    DENSE
			)
		formatString: 0
		lineageTag: 4969dab7-a2e8-4f7a-a54f-03d5069ce3c8

	measure 'Is Top 10 Brand' = ```
			
			IF(
			    NOT ISINSCOPE(orbis_dimension_01[Brand]),
			    1,
			    VAR CurrentCategory = SELECTEDVALUE(orbis_dimension_01[Category])
			    VAR CurrentBrand = SELECTEDVALUE(orbis_dimension_01[Brand])
			    VAR AllBrandValues =
			        CALCULATETABLE(
			            SUMMARIZE(
			                orbis_dimension_01,
			                orbis_dimension_01[Brand],
			                "Val", CALCULATE(
			                    [Value P12M],
			                    ALL(orbis_dimension_01),
			                    orbis_dimension_01[Category] = CurrentCategory
			                )
			            ),
			            ALL(orbis_dimension_01)
			        )
			    VAR Top10 =
			        TOPN(10, AllBrandValues, [Val], DESC)
			    VAR IsInTop10 =
			        COUNTROWS(
			            FILTER(Top10, orbis_dimension_01[Brand] = CurrentBrand)
			        )
			    RETURN
			        IF(IsInTop10 > 0, 1, 0)
			)
			// Brand Rank For Filter = 
