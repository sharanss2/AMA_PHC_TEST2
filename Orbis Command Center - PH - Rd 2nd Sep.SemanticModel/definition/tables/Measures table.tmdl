	measure 'Sales (MSU)' =
			
			VAR possales = CALCULATE(SUM(pos_data_03[Sales_MSU]))
			VAR rtdxsales = CALCULATE(SUM(rtdx_data_02[Sales_MSU]))
			VAR shipmentsales = CALCULATE(SUM(shipmenets_data_07[Order_Qty_MSU]),shipmenets_data_07[StatusCode] in {"40","50"})
			// [Shipment Order]
			VAR poscust = CALCULATETABLE(VALUES(pos_data_03[Customer]), ALL(DateTable[Month Year]))
			VAR rtdxcust = CALCULATETABLE(VALUES(rtdx_data_02[Customer]), ALL(DateTable[Month Year]))
			VAR shipmentcust = CALCULATETABLE(VALUES(shipmenets_data_07[Customer]), ALL(DateTable[Month Year]))
			VAR customers = SELECTEDVALUE(orbis_dimension_01[customer])
			VAR res = SWITCH(TRUE(), customers IN poscust, possales,
			            customers IN rtdxcust, rtdxsales, possales)
			            // customers IN shipmentcust, shipmentsales, possales)
			RETURN
			res
			// COALESCE(res, 0)
			// possales + rtdxsales
			            // NOT (customers IN poscust && customers IN rtdxcust), shipmentsales)
