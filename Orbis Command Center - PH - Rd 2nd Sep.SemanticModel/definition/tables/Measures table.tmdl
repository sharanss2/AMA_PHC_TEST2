	measure 'Front Shop Sales Val LY (in MM)' =
			
			VAR MaxDateWithData = CALCULATE(MAX(iqvia_frontshop_01[period_end_date]), ALL(iqvia_frontshop_01))
			RETURN
			SUMX(
			    KEEPFILTERS(VALUES(DateTable[Date])),
			    IF (
			        DateTable[Date] <= MaxDateWithData,
			        CALCULATE (
			            [Front Shop Sales Val (in MM)],
			            DATEADD ( DateTable[Date], -1, YEAR )
			        ),
			        BLANK()
			    )
			)
		lineageTag: b39fd555-6702-4a41-94cc-02547f9352cf

