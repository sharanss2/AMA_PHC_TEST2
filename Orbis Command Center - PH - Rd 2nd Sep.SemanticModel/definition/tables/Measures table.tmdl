	measure 'Back Shop Sales LY' =
			
			VAR MaxDateWithData = CALCULATE(MAX(iqvia_backshop_05[period_end_date]), ALL(iqvia_backshop_05))
			RETURN
			SUMX(
			    KEEPFILTERS(VALUES(DateTable[Date])),
			    IF (
			        DateTable[Date] <= MaxDateWithData,
			        CALCULATE (
			            [Back Shop Sales],
			            DATEADD ( DateTable[Date], -1, YEAR )
			        ),
			        BLANK()
			    )
			)
		lineageTag: e823e9ea-301a-45c1-b63c-268bc3766dc0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Back Shop Sales PXM' = ```
			
			VAR _SelectedPeriod =
			    SELECTEDVALUE ( 'Time Period'[Period] )
			
			// VAR _MaxDate =
			//    MAX ( DateTable[Date] )
			VAR _SlicerDate = MAX('Slicer Month Year'[Date])
			VAR _CalendarDate = MAX(DateTable[Date])
			VAR _MaxDate = 
			    IF ( 
			        ISFILTERED('Slicer Month Year'), 
			        EOMONTH(_SlicerDate, 0), -- Use the end of the month from the slicer
			        EOMONTH(_CalendarDate, 0)     -- Fallback to default behavior
			    )
			
			RETURN
			// _MaxDate
			SWITCH (    
			    TRUE(),
			
			    /* P1M */
			    _SelectedPeriod = "P1M",
			        CALCULATE (
			            [Back Shop Sales],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -1,
			                MONTH
			            )
			        ),
			
			    /* P3M */
			    _SelectedPeriod = "P3M",
			        CALCULATE (
			           [Back Shop Sales],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -3,
			                MONTH
			            )
			        ),
			
			    /* P6M */
			    _SelectedPeriod = "P6M",
			        CALCULATE (
			            [Back Shop Sales],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -6,
			                MONTH
			            )
			        ),
			
			    /* P12M */
			    _SelectedPeriod = "P12M",
			        CALCULATE (
			            [Back Shop Sales],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -12,
			                MONTH
			            )
			        ),
			
			    /* MTD */
			    _SelectedPeriod = "MTD",
			        CALCULATE (
			            [Back Shop Sales],
			            DATESMTD ( DateTable[Date] )
			        ),
			
			    /* QTD */
			    _SelectedPeriod = "QTD",
			        CALCULATE (
			            [Back Shop Sales],
			            DATESQTD ( DateTable[Date] )
			        ),
			
			    /* FYTD */
			    // _SelectedPeriod = "FYTD",
			    //     CALCULATE (
			    //         [Back Shop Sales],
			    //         DATESYTD (
			    //             DateTable[Date],
			    //             "06/30"   /* change if fiscal year end is different */
			    //         )
			    //     ),
			
			            /* FYTD (July to June) anchored to Slicer */
			    _SelectedPeriod = "FYTD",
			        CALCULATE (
			            [Back Shop Sales],
			            CALCULATETABLE (
			                DATESYTD ( DateTable[Date], "06/30" ),
			                DateTable[Date] = _MaxDate
			            )
			        ),
			
			    /* Default fallback */
			    [Back Shop Sales]
			)
			
			```
		lineageTag: 55d3d64e-f7cd-458c-ba3e-f053289f3f10

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Back Shop Sales LY PXM' = ```
			
			VAR _SelectedPeriod =
			    SELECTEDVALUE ( 'Time Period'[Period] )
			
			VAR _SlicerDate = MAX('Slicer Month Year'[Date])
			VAR _CalendarDate = MAX(DateTable[Date])
			VAR _MaxDate = 
			    IF ( 
			        ISFILTERED('Slicer Month Year'), 
			        EOMONTH(_SlicerDate, 0), -- Use the end of the month from the slicer
			        EOMONTH(_CalendarDate, 0)     -- Fallback to default behavior
			    )
			
			RETURN
			// _MaxDate
			SWITCH (    
			    TRUE(),
			
			    /* P1M */
			    _SelectedPeriod = "P1M",
			        CALCULATE (
			            [Back Shop Sales LY],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -1,
			                MONTH
			            )
			        ),
			
			    /* P3M */
			    _SelectedPeriod = "P3M",
			        CALCULATE (
			           [Back Shop Sales LY],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -3,
			                MONTH
			            )
			        ),
			
			    /* P6M */
			    _SelectedPeriod = "P6M",
			        CALCULATE (
			            [Back Shop Sales LY],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -6,
			                MONTH
			            )
			        ),
			
			    /* P12M */
			    _SelectedPeriod = "P12M",
			        CALCULATE (
			            [Back Shop Sales LY],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -12,
			                MONTH
			            )
			        ),
			
			    /* MTD */
			    _SelectedPeriod = "MTD",
			        CALCULATE (
			            [Back Shop Sales LY],
			            DATESMTD ( DateTable[Date] )
			        ),
			
			    /* QTD */
			    _SelectedPeriod = "QTD",
			        CALCULATE (
			            [Back Shop Sales LY],
			            DATESQTD ( DateTable[Date] )
			        ),
			
			    /* FYTD */
			    // _SelectedPeriod = "FYTD",
			    //     CALCULATE (
			    //         [Back Shop Sales LY],
			    //         DATESYTD (
			    //             DateTable[Date],
			    //             "06/30"   /* change if fiscal year end is different */
			    //         )
			    //     ),
			
			        /* FYTD (July to June) anchored to Slicer */
			    _SelectedPeriod = "FYTD",
			        CALCULATE (
			            [Back Shop Sales LY],
			            CALCULATETABLE (
			                DATESYTD ( DateTable[Date], "06/30" ),
			                DateTable[Date] = _MaxDate
			            )
			        ),
			
			    /* Default fallback */
			    [Back Shop Sales LY]
			)
			```
		lineageTag: d8292a84-ef11-4af2-b6a6-5d8f63bc5009

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Back Shop Sales (in MM or MSU)' = ```
			
			// VAR CurrentValue = 
			// [Front Shop Sales PXM]
			VAR CurrentValue = 
			IF( ISINSCOPE('Time Period'[Period]), 
			[Back Shop Sales PXM] ,
			SUMX(
			    VALUES('DateTable'[Month Year]), -- Iterates through every month in the current context
			    IF(
			        [Show Backshop Month Range] = 1,
			        [Back Shop Sales PXM] ,
			        BLANK()
			        )
			    )
			 )
			
			VAR currvalMM =  IF(ISBLANK(CurrentValue), BLANK(),DIVIDE( CurrentValue, 1000000))
			RETURN
			SWITCH(SELECTEDVALUE('Switcher Table'[Value/Volume]), "Value",currvalMM , CurrentValue)
			    // SWITCH (
			    //     TRUE (),
			    //     // CurrentValue >= 10000 && CurrentValue < 1000000, 
			    //     //     FORMAT ( CurrentValue / 1000, "#,0.0" ) & "M",
			            
			    //     CurrentValue >= 1000000, 
			    //         FORMAT ( CurrentValue / 1000000, "#,0.0" ) & "MM"
			            
			    //     // CurrentValue < 10000, 
			    //     //     FORMAT ( CurrentValue, "#,0" ),
			            
			    //     // FORMAT ( CurrentValue, "#,0" )
			    // )
			```
		lineageTag: a61feac7-34c3-4a5c-8570-59f3a4a03156

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Show Backshop Month Range' =
			
			
			VAR SelectedDate = MIN('Slicer Month Year'[Date]) -- The first day of the month selected in slicer
			VAR EndDate = EOMONTH(TODAY(), 0)         -- The last day of the current month
			VAR MatrixDate = MAX(iqvia_backshop_05[period_end_date])         -- The date currently being drawn in the Matrix
			
			RETURN
			IF(
			    MatrixDate >= SelectedDate && MatrixDate <= EndDate,
			    1,
			   BLANK()
			)
		formatString: 0
		lineageTag: 9ae04ee2-dff2-420d-a003-92e182e8d621

	measure 'Back Shop IYA PXM' = ```
			
			 DIVIDE([Back Shop Sales PXM], [Back Shop Sales LY PXM]) * 100
			```
		lineageTag: 98e0e1ac-c1dc-45d2-9450-893ee5e12ef8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Filtered Backshop IYA' = ```
			
			VAR VisibleSales =     SUMX(
			        VALUES('DateTable'[Month Year]),
			        IF([Show Backshop Month Range] = 1, [Back Shop Sales PXM], BLANK())
			    )
			VAR VisibleLYSales = 
			    SUMX(
			        VALUES('DateTable'[Month Year]),
			        IF([Show Backshop Month Range] = 1, [Back Shop Sales LY PXM], BLANK())
			    )
			RETURN
			DIVIDE(VisibleSales, VisibleLYSales) * 100
			// IF(
			//     [Show POS Month Range] = 1, 
			//     [Shipments IYA PXM], 
			//     BLANK()
			// )
			```
		lineageTag: 60ca0d66-af67-40a9-ac42-00b3340e1935

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Filtered FB IYA' =
			VAR rx = CALCULATE([Filtered Backshop IYA], ALL(iqvia_backshop_05), iqvia_backshop_05[RxOtc] = "Rx")
			VAR Otc =  CALCULATE([Filtered Backshop IYA], iqvia_backshop_05[RxOtc] = "Otc")
			VAR fs =  [Filtered Frontshop IYA]
			
			RETURN
			SWITCH(SELECTEDVALUE('FB filter'[Filter]), "Rx", rx, "Otc", Otc, "Frontshop", fs)
		lineageTag: fa81d96d-db08-463b-b249-084ac3b463a9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'FB Sales (in MM or MSU)' =
			
			VAR rx = CALCULATE([Back Shop Sales (in MM or MSU)], ALLEXCEPT(iqvia_backshop_05, iqvia_backshop_05[Brand], iqvia_backshop_05[Product], iqvia_backshop_05[period_end_date]), iqvia_backshop_05[RxOtc] = "Rx")
			
			VAR Otc =  CALCULATE([Back Shop Sales (in MM or MSU)], ALLEXCEPT(iqvia_backshop_05, iqvia_backshop_05[Brand], iqvia_backshop_05[Product], iqvia_backshop_05[period_end_date] ), iqvia_backshop_05[RxOtc] = "OTC")
			
			VAR fs =  CALCULATE([Front Shop Sales (in M or MSU)],  ALL(iqvia_frontshop_01), iqvia_frontshop_01[Non RxOtc] = "Frontshop")
			
			RETURN
			SWITCH(SELECTEDVALUE('FB filter'[Filter]), "Rx", rx, "Otc", Otc, "Frontshop", fs)
