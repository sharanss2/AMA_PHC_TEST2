	measure 'IQVIA Sales' =
			
			VAR val = SUM(iqvia_data_01[Sales])
			VAR vol = SUM(iqvia_data_01[Units])
			
			VAR res = SWITCH(SELECTEDVALUE('Switcher Table'[Value/Volume]), "Value", val, "Volume", vol)
