	measure 'Sellout PH PXM' = ```
			
			VAR _SelectedPeriod =
			    SELECTEDVALUE ( 'Time Period'[Period] )
			
			VAR _SlicerDate = MAX('Slicer Month Year'[Date])
			VAR _CalendarDate = MAX(DateTable[Date])
			VAR _MaxDate = 
			    IF ( 
			        ISFILTERED('Slicer Month Year'), 
			        EOMONTH(_SlicerDate, 0), -- Use the end of the month from the slicer
			        EOMONTH(_CalendarDate, 0)     -- Fallback to default behavior
			    )
			VAR _SelectedDate = 
			    IF ( 
			        ISFILTERED('Slicer Month Year'), 
			        EOMONTH(_SlicerDate, 0), -- Use the end of the month from the slicer
			        EOMONTH(_CalendarDate, 0)     -- Fallback to default behavior
			    )
			RETURN
			SWITCH (    
			    TRUE(),
			
			        _SelectedPeriod = "Selected Month",
			        CALCULATE (
			            [Sellout PH],
			            DATESINPERIOD (
			                DateTable[Date],
			                _SelectedDate,
			                -1,
			                MONTH
			            )
			        ),
			    
			
			    /* P1M */
			    _SelectedPeriod = "P1M",
			        CALCULATE (
			            [Sellout PH],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -1,
			                MONTH
			            )
			        ),
			
			    /* P3M */
			    _SelectedPeriod = "P3M",
			        CALCULATE (
			           [Sellout PH],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -3,
			                MONTH
			            )
			        ),
			
			    /* P6M */
			    _SelectedPeriod = "P6M",
			        CALCULATE (
			            [Sellout PH],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -6,
			                MONTH
			            )
			        ),
			
			    /* P12M */
			    _SelectedPeriod = "P12M",
			        CALCULATE (
			            [Sellout PH],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -12,
			                MONTH
			            )
			        ),
			
			    /* MTD */
			    _SelectedPeriod = "MTD",
			        CALCULATE (
			            [Sellout PH],
			            DATESMTD ( DateTable[Date] )
			        ),
			
			    /* QTD */
			    _SelectedPeriod = "QTD",
			        CALCULATE (
			            [Sellout PH],
			            DATESQTD ( DateTable[Date] )
			        ),
			
			    /* FYTD */
			    _SelectedPeriod = "FYTD",
			        CALCULATE (
			            [Sellout PH],
			            CALCULATETABLE (
			                DATESYTD ( DateTable[Date], "06/30" ),
			                DateTable[Date] = _MaxDate
			            )
			        ),
			
			    /* Default fallback */
			    [Sellout PH]
			)
			
			```
		lineageTag: 1a6d80bb-e4a7-4ced-8842-e36a9324e629

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sellout PH LY PXM' =
			
			CALCULATE (
			    [Sellout PH PXM],
			    DATEADD ( DateTable[Date], -1, YEAR )
			)
		lineageTag: 2108873c-d1a6-419d-ab1a-d0747658edd8

