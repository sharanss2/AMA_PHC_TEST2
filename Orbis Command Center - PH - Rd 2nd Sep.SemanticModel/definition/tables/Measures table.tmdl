	measure 'Sales (MM)' =
			
			VAR  StartCurrentMonth = DATE(YEAR(TODAY()),MONTH(TODAY()), 1)
			VAR  StartNextMonth = EDATE(StartCurrentMonth, 1)
			VAR  sales = COALESCE(CALCULATE(SUM(shipmenets_data_07[NIV]),shipmenets_data_07[Requested_Delivery_Date] >= StartCurrentMonth,shipmenets_data_07[Requested_Delivery_Date] < StartNextMonth),0)
			
			RETURN
			DIVIDE(sales, 1000000)
		formatString: "R"#,0.00;-"R"#,0.00;"R"#,0.00
		lineageTag: 4064ce54-bea2-4f3f-a7a7-1d924771eb98

		annotation PBI_FormatHint = {"currencyCulture":"en-ZA"}

	measure 'Is Current MOnth' =
			
			VAR  StartCurrentMonth = DATE(YEAR(TODAY()),MONTH(TODAY()), 1)
			VAR  StartNextMonth = EDATE(StartCurrentMonth, 1)
			
			RETURN
			IF ( MAX(shipmenets_data_07[Requested_Delivery_Date]) >= StartCurrentMonth && MAX(shipmenets_data_07[Requested_Delivery_Date]) < StartNextMonth,1,0)
		formatString: 0
		lineageTag: 8a9a71cb-c51b-42f4-837f-75c40a516fa3

