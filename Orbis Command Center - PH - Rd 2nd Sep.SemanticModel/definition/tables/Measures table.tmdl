	measure 'Front Shop Sales (in MM or MSU)' = ```
			
			 VAR rawsales = IF(
			    [Sales Visibility Filter IQVIA] = 0,
			    BLANK(), -- Use BLANK() if you want it completely empty
			    [Front Shop Sales PXM]
			)
			// VAR CurrentValue = 
			// [Front Shop Sales PXM]
			VAR CurrentValue = 
			IF( ISINSCOPE('Time Period'[Period]), 
			rawsales ,
			SUMX(
			    VALUES('DateTable'[Month Year]), -- Iterates through every month in the current context
			    IF(
			        [Show IQVIA All Month Range] = 1,
			        [Front Shop Sales PXM] ,
			        BLANK()
			        )
			    )
			 )
			
			VAR currvalMM =  IF(ISBLANK(CurrentValue), BLANK(), DIVIDE( CurrentValue, 1000000))
			RETURN
			// CurrentValue
			// SWITCH(SELECTEDVALUE('Switcher Table'[Value/Volume]), "Value",currvalMM , CurrentValue)
			SWITCH(SELECTEDVALUE('Switcher Table'[Value/Volume]), "Value", currvalMM, "Volume (MSU)", CurrentValue, "Volume (Units)", CurrentValue)
			
			
			    // SWITCH (
			    //     TRUE (),
			    //     // CurrentValue >= 10000 && CurrentValue < 1000000, 
			    //     //     FORMAT ( CurrentValue / 1000, "#,0.0" ) & "M",
			            
