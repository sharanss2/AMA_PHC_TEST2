			    ------------------------------------------  Consumer Aisle --------------------------------------
			    VAR _pgval_ca = IF(NOT ISFILTERED(orbis_dimension_01[customer]), _pgval_ca_default, _pgval_ca_nd)
			    
			    -------------------------------------------------------------------------------------------------
			
			    ------------------------------------------FrontShop-------------------------------------
			    VAR _pgval_fs = CALCULATE([Value PXM], ALL(orbis_dimension_01[DataType]), orbis_dimension_01[DataType] in {"IQVIA_FRONTSHOP"}, ALL(orbis_dimension_01[P&G Flag]), orbis_dimension_01[P&G Flag] = 1)
			    
			    -------------------------------------------------------------------------------------------------
			
			    ------------------------------------------Backshop-------------------------------------
			    VAR _pgval_bs = CALCULATE([Value PXM], ALL(orbis_dimension_01[DataType]), orbis_dimension_01[DataType] in { "IQVIA_BACKSHOP"}, ALL(orbis_dimension_01[P&G Flag]), orbis_dimension_01[P&G Flag] = 1)
			   
			    -------------------------------------------------------------------------------------------------
			
			    ----------------------------------------Total----------------------------------------------------
			    VAR _pgval = SWITCH(TRUE(), 
			            SELECTEDVALUE(orbis_dimension_01[DataType]) in {"IQVIA_CONSUMERAISLE"}, _pgval_ca, 
			            SELECTEDVALUE(orbis_dimension_01[DataType]) in {"IQVIA_FRONTSHOP"}, _pgval_fs, 
			            SELECTEDVALUE(orbis_dimension_01[DataType]) in {"IQVIA_BACKSHOP"}, _pgval_bs,
			            _pgval_ca+_pgval_fs+_pgval_bs
			            )
			
			 
			    RETURN
			    SWITCH (
			        TRUE (),
			        _pgval >= 10000 && _pgval < 1000000, 
			            FORMAT ( _pgval / 1000, "#,0.0" ) & "M",
			            
			        _pgval >= 1000000, 
			            FORMAT ( _pgval / 1000000, "#,0.0" ) & "MM",
			            
			        _pgval < 10000, 
			            FORMAT ( _pgval, "#,0" ),
			            
			        FORMAT ( _pgval, "#,0" )
			    )
			```
		lineageTag: 7ed58f86-df47-46f9-bf2f-a90ff0846d82

