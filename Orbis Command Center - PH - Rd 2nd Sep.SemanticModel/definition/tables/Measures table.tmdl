		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'IYA Visibility Filter IQVIA' =
			
			VAR SelectedDate = MAX('Slicer Month Year'[Date]) -- Or your Period End Date
			VAR SelectedPeriod = SELECTEDVALUE('Time Period'[Period]) -- e.g., "FYTD", "P12M"
			
			RETURN
			SWITCH( TRUE(),
			    SelectedPeriod = "FYTD" && SelectedDate <= DATE(2025, 7, 1), 0,
			    SelectedPeriod = "P12M" && SelectedDate <= DATE(2026, 3, 1), 0,
			    SelectedPeriod = "P6M"  && SelectedDate <= DATE(2025, 9, 1), 0,
			    SelectedPeriod = "P3M"  && SelectedDate <= DATE(2025, 6, 1), 0,
			    SelectedPeriod = "P1M"  && SelectedDate <= DATE(2025, 4, 1), 0,
			    1 -- Default to visible
			)
		formatString: 0
		lineageTag: 3be6a881-13e8-4ca5-a104-4b7552892093

	measure 'IYA Visibility Filter Temp' =
			
			VAR SelectedDate = MAX('Slicer Month Year'[Date]) -- Or your Period End Date
			VAR SelectedPeriod = SELECTEDVALUE('Time Period'[Period]) -- e.g., "FYTD", "P12M"
			
			RETURN
			SelectedDate
			// SWITCH( TRUE(),
			//     SelectedPeriod = "FYTD" && SelectedDate < DATE(2025, 7, 1), 0,
			//     SelectedPeriod = "P12M" && SelectedDate < DATE(2026, 3, 1), 0,
