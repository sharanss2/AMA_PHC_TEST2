	measure 'Brand Rank Per Category' =
			
			VAR CurrentCategory = SELECTEDVALUE(orbis_dimension_01[category])
			RETURN
			RANKX(
			    FILTER(
			        ALL(orbis_dimension_01[Brand]),
			        CALCULATE(
			            [Value P12M],
			            orbis_dimension_01[category] = CurrentCategory
			        ) > 0
			    ),
			    CALCULATE([Value P12M]),
			    ,
			    DESC,
			    DENSE
			)
		formatString: 0
		lineageTag: 9f265871-f21b-4b06-8280-6637f298e394

	measure 'Show Top 10 Brand 1' =
			
			IF(
			    [Brand Rank Per Category] <= 10,
			    1,
			    0
			)
		formatString: 0
		lineageTag: 4a16c6b8-1837-490a-92d4-170c860e2705

	measure 'Brand Rank Display' =
			
			VAR CurrentCategory = SELECTEDVALUE(orbis_dimension_01[category])
			VAR CurrentBrand = SELECTEDVALUE(orbis_dimension_01[Brand])
			RETURN
			RANKX(
			    FILTER(
			        ALL(orbis_dimension_01[Brand]),
			        CALCULATE(
			            [Value P12M],
			            orbis_dimension_01[category] = CurrentCategory
			        ) > 0
			    ),
			    CALCULATE([Value P12M]),
			    ,
