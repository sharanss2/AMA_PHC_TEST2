		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Show Last 12 Months' =
			
			VAR EndMonth =
			   MAXX(
			       ALLSELECTED('DateTable'),
			       'DateTable'[Month Index]
			   )
			VAR CurrentMonth =
			   MAX('DateTable'[Month Index])
			RETURN
			IF(
			   CurrentMonth >= EndMonth - 11 &&
			   CurrentMonth <= EndMonth,
			   1,
			   0
			)
		formatString: 0
		lineageTag: eed8f35a-bf42-4d78-89fe-a9aff404f103

	measure 'Salience Shipments' = ```
			
			100*
			SWITCH(
			
			    TRUE(),
			
			    -- Product contribution within Segment
			
			    ISINSCOPE('orbis_dim_ph_01'[Product]),
			
			        DIVIDE(
			
			            [Shipments PH PXM],
			
			            CALCULATE(
			
			                [Shipments PH PXM],
			
			                ALLSELECTED('orbis_dim_ph_01'[Product])
			
			            )
			
			        ),
			
			    -- Segment contribution within Brand
			
			    ISINSCOPE('orbis_dim_ph_01'[Segment]),
			
			        DIVIDE(
			
			            [Shipments PH PXM],
			
			            CALCULATE(
			
			                [Shipments PH PXM],
			
			                ALLSELECTED('orbis_dim_ph_01'[Segment])
			
			            )
			
			        ),
			
			    -- Brand contribution to Total
			
			    ISINSCOPE('orbis_dim_ph_01'[Brand]),
			
			        DIVIDE(
			
			            [Shipments PH PXM],
			
			            CALCULATE(
			
			                [Shipments PH PXM],
			
			                ALLSELECTED('orbis_dim_ph_01'[Brand])
			
			            )
			
			        )
			
			)
			 
			```
		formatString: 0.0
		lineageTag: b031ecfd-0b99-4efe-849d-834bab84052a

	measure 'Shipments PH PXM Bar' = ```
			
			VAR _SelectedPeriod =
			    SELECTEDVALUE ( 'Time Period'[Period] )
			
			VAR _SlicerDate = MAX('Slicer Month Year'[Date])
			VAR _CalendarDate = MAX(DateTable[Date])
			VAR _MaxDate = 
			    IF ( 
			        ISFILTERED('Slicer Month Year'), 
			        EOMONTH(_SlicerDate, 0), -- Use the end of the month from the slicer
			        EOMONTH(_CalendarDate, 0)     -- Fallback to default behavior
			    )
			VAR _SelectedDate = 
			    IF ( 
			        ISFILTERED('Slicer Month Year'), 
			        EOMONTH(_SlicerDate, 0), -- Use the end of the month from the slicer
			        EOMONTH(_CalendarDate, 0)     -- Fallback to default behavior
			    )
			RETURN
			SWITCH (    
			    TRUE(),
			
			        _SelectedPeriod = "Selected Month",
			        CALCULATE (
			            [Shipments PH],
			            DATESINPERIOD (
			                DateTable[Date],
			                _SelectedDate,
			                -1,
			                MONTH
			            )
			        ),
			    
			
			    /* P1M */
			    _SelectedPeriod = "P1M",
			        CALCULATE (
			            [Shipments PH],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -1,
			                MONTH
			            )
			        ),
			
			    /* P3M */
			    _SelectedPeriod = "P3M",
			        CALCULATE (
			           [Shipments PH],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -3,
			                MONTH
			            )
			        ),
			
			    /* P6M */
			    _SelectedPeriod = "P6M",
			        CALCULATE (
			            [Shipments PH],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -6,
			                MONTH
			            )
			        ),
			
			    /* P12M */
			    _SelectedPeriod = "P12M",
			        CALCULATE (
			            [Shipments PH],
			            DATESINPERIOD (
			                DateTable[Date],
			                _MaxDate,
			                -12,
			                MONTH
			            )
			        ),
			
			    /* MTD */
			    _SelectedPeriod = "MTD",
			        CALCULATE (
			            [Shipments PH],
			            DATESMTD ( DateTable[Date] )
			        ),
			
			    /* QTD */
			    _SelectedPeriod = "QTD",
			        CALCULATE (
			            [Shipments PH],
			            DATESQTD ( DateTable[Date] )
			        ),
			
			    /* FYTD */
			    _SelectedPeriod = "FYTD",
			        CALCULATE (
			            [Shipments PH],
			            CALCULATETABLE (
			                DATESYTD ( DateTable[Date], "06/30" ),
			                DateTable[Date] = _MaxDate
			            )
			        ),
			
			    /* Default fallback */
			    [Shipments PH]
			)
			```
		lineageTag: b3c9bfa5-97c4-4a44-b6de-1feeadb643bd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

