			VAR _totalval_fs = CALCULATE([Volume (Units) PXM], ALL(orbis_dimension_01[Brand]), All(orbis_dimension_01[Product]), ALL(orbis_dimension_01[P&G Flag]), ALL(orbis_dimension_01[DataType]), orbis_dimension_01[DataType] in {"IQVIA_FRONTSHOP"})
