	measure 'Show POS Month Range' =
			
			
			// VAR SelectedDate =
			//     MIN('Slicer Month Year'[Date])
			
			// VAR EndDate =
			//     EOMONTH(TODAY(), 0)
			
			// VAR MatrixDate =
			//     MAXX(
			//         UNION(
			//             SELECTCOLUMNS(pos_data_03, "Dt", pos_data_03[period_end_date]),
			//             SELECTCOLUMNS(shipmenets_data_07, "Dt", shipmenets_data_07[GI_Date])
