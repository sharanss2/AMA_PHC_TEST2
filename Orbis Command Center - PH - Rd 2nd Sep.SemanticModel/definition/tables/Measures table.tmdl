	measure 'Formatted Shipment Value' =
			
			VAR _Value = [Shipments PH PXM]
			RETURN
			SWITCH(
			   TRUE(),
			   ABS(_Value) >= 1000000,
			       FORMAT(_Value / 1000000, "0.0") & "MM",
			   ABS(_Value) >= 1000,
			       FORMAT(_Value / 1000, "0.0") & "M",
			   FORMAT(_Value, "#,##0")
			)
