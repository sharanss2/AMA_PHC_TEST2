			VAR EndDate = EOMONTH(TODAY(), 0)         -- The last day of the current month
			VAR MatrixDate = MAX(pos_data_03[period_end_date])         -- The date currently being drawn in the Matrix
			VAR date_main = CALCULATE(MAX(DateTable[Date]), ALL(DateTable[Date]), DateTable[Date] = SelectedDate)
