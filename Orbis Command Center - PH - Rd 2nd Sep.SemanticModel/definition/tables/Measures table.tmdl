		formatString: General Date
		lineageTag: cdc41f3e-9e80-4f7a-b387-6d02a1d472a8

	measure 'Sales Visibility Filter IQVIA' =
			
			VAR SelectedDate = MAX('Slicer Month Year'[Date]) -- Or your Period End Date
			VAR SelectedPeriod = SELECTEDVALUE('Time Period'[Period]) -- e.g., "FYTD", "P12M"
			
			RETURN
			SWITCH( TRUE(),
			    SelectedPeriod = "FYTD" && SelectedDate <= DATE(2024, 7, 1), 0,
			    1 -- Default to visible
			)
		formatString: 0
		lineageTag: 2aa7e4d4-1caf-47df-888c-e58d672e5360

