	measure 'Volume LY' =
			
			
			VAR MaxDateWithData = CALCULATE(MAX(shipmenets_ph_data_01[period_end_date]), ALL(shipmenets_ph_data_01))
			RETURN
			SUMX(
			    KEEPFILTERS(VALUES(DateTable[Date])),
			    IF (
			        DateTable[Date] <= MaxDateWithData,
			        CALCULATE (
			            [Volume (Units)],
			            DATEADD ( DateTable[Date], -1, YEAR )
			        ),
			        BLANK()
			    )
			)
