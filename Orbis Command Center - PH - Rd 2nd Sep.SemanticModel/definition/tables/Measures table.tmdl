	measure 'Value Share LY (Grouped)' = ```
			
			VAR _TopNLimit = 10
			
			-- 1. Identify the Top 10 Brands based on P12M Value
			VAR _Top10Brands = 
			    TOPN(
			        _TopNLimit, 
			        ALLSELECTED(orbis_dimension_01[Brand]), 
			        [Value P12M], 
			        DESC
			    )
			
			-- 2. Capture the current row context from your NEW 'Brand_Grouped' table
			VAR _CurrentBrandRow = SELECTEDVALUE('Brand_Grouped'[Brand])
			
			-- 3. Calculations for Top 10 and Total
			VAR _TotalValue = [Value Share New LY]
			VAR _Top10Value = CALCULATE([Value Share New LY], KEEPFILTERS(_Top10Brands))
			VAR _OthersValue = _TotalValue - _Top10Value
			
			RETURN
			IF(
			    NOT ISINSCOPE('Brand_Grouped'[Brand]),
			    -- If we are at Category level, show the full total
			    _TotalValue,
			    
			    -- If we are at Brand level or below
			    SWITCH( TRUE(),
			        -- Case: The brand is in the Top 10
			        CONTAINSROW(_Top10Brands, _CurrentBrandRow),
			            CALCULATE([Value Share New LY], orbis_dimension_01[Brand] = _CurrentBrandRow),
			        
			        -- Case: The 'Others' row
			        _CurrentBrandRow = "Others", 
			            _OthersValue,
			            
			        BLANK()
			    )
			)
			```
		lineageTag: 2281f151-742e-4dd8-b160-a97125d235b8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Volume Share LY (Grouped)' = ```
			
