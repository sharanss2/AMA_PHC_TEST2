	measure Projection = ```
			
			VAR salesp2m = CALCULATE(
			    [Sales (MSU)] ,
			    DATESINPERIOD(
			        DateTable[Date],
			        MAX(DateTable[Date]),
			        -2,
			        MONTH
			    )
			)  
			
			VAR denum = DIVIDE(salesp2m, 8)
			VAR num = [Closing Inventory Volume] 
			VAR res = DIVIDE(num, denum, BLANK())
			RETURN
			IF(ISBLANK(res), "--", res)
			
			```
