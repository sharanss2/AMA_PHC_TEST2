			VAR _totalval_bs = CALCULATE([Volume (Units) PXM], ALL(orbis_dimension_01[Brand]), All(orbis_dimension_01[Product]), ALL(orbis_dimension_01[P&G Flag]), ALL(orbis_dimension_01[DataType]), orbis_dimension_01[DataType] in {"IQVIA_BACKSHOP"})
			// VAR res_fb = DIVIDE(_pgval_bs, _totalval_bs, BLANK())
			-------------------------------------------------------------------------------------------------
			
			----------------------------------------Total----------------------------------------------------
			VAR _pgval = SWITCH(TRUE(), 
			        SELECTEDVALUE(orbis_dimension_01[DataType]) in {"IQVIA_CONSUMERAISLE"}, _pgval_ca, 
			        SELECTEDVALUE(orbis_dimension_01[DataType]) in {"IQVIA_FRONTSHOP"}, _pgval_fs, 
