	measure 'Volume New 2' = ```
			
			VAR _pgval_ca_default =  CALCULATE([Volume (MSU) PXM], ALL(orbis_dimension_01[customer]), orbis_dimension_01[customer] = "TOTAL TD/ST")
			
			
			VAR _pgval_ca_nd =  CALCULATE([Volume (MSU) PXM], ALL(orbis_dimension_01[P&G Flag]), orbis_dimension_01[P&G Flag] = 1, ALL(orbis_dimension_01[DataType]))
			
			------------------------------------------  Consumer Aisle --------------------------------------
			VAR _pgval_ca = IF(NOT ISFILTERED(orbis_dimension_01[customer]), _pgval_ca_default, _pgval_ca_nd)
			
			-------------------------------------------------------------------------------------------------
			
			------------------------------------------FrontShop-------------------------------------
			VAR _pgval_fs = CALCULATE([Volume (MSU) PXM], ALL(orbis_dimension_01[DataType]), orbis_dimension_01[DataType] in {"IQVIA_FRONTSHOP"})
			
			-------------------------------------------------------------------------------------------------
			
			------------------------------------------Backshop-------------------------------------
			VAR _pgval_bs = CALCULATE([Volume (MSU) PXM],  ALL(orbis_dimension_01[DataType]), orbis_dimension_01[DataType] in { "IQVIA_BACKSHOP"})
			
			-------------------------------------------------------------------------------------------------
			
			----------------------------------------Total----------------------------------------------------
			VAR _pgval = SWITCH(TRUE(), 
			        SELECTEDVALUE(orbis_dimension_01[DataType]) in {"IQVIA_CONSUMERAISLE"}, _pgval_ca, 
			        SELECTEDVALUE(orbis_dimension_01[DataType]) in {"IQVIA_FRONTSHOP"}, _pgval_fs, 
			        SELECTEDVALUE(orbis_dimension_01[DataType]) in {"IQVIA_BACKSHOP"}, _pgval_bs,
			        _pgval_ca+_pgval_fs+_pgval_bs
			        )
			
			RETURN
			_pgval
			```
